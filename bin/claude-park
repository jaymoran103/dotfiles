#!/usr/bin/env python3
"""claude-park — manage visibility of Claude Code background sessions.

Parking moves a session's job record from ~/.claude/jobs into
~/.claude/jobs-parked. The row disappears from `claude agents`.
The transcript in ~/.claude/projects is never touched, so
`claude --resume <session-id>` still works. Unparking puts it back.

Shift+Up / Shift+Down reorder the highlighted row. The order is kept in
~/.claude/claude-park-order.json and survives restarts.

Ctrl+S groups each section by cwd, as `claude agents` does, and back to
recency. Enter on a title row folds or unfolds that group, or that
section in the recency view. - folds every one and + unfolds them. The
view and the folded rows are kept in the same file.

Ctrl+X deletes a job record outright. That store is all it removes, so the
transcript and `claude --resume` survive a delete as they do a park.

h opens the key panel. Keys pressed there run as if typed on the list,
so it doubles as a menu. --keys prints the same list.
"""

import curses
import json
import os
import shutil
import sys
import time

HOME = os.path.expanduser("~")
JOBS = os.environ.get("CLAUDE_JOBS_DIR", os.path.join(HOME, ".claude", "jobs"))
PARK = os.environ.get("CLAUDE_PARK_DIR", os.path.join(HOME, ".claude", "jobs-parked"))
ORDER = os.environ.get("CLAUDE_PARK_ORDER",
                       os.path.join(HOME, ".claude", "claude-park-order.json"))

TERMINAL = {"done", "stopped", "failed", "error", "killed", "cancelled", "exited"}
SELF = os.path.basename(os.environ.get("CLAUDE_JOB_DIR", "").rstrip("/"))

# The session's own colour, the `color` field in state.json, shows as a
# one-cell blip a space ahead of the name. The state word carries a
# colour of its own. The rest of the row stays plain, and the highlight
# lifts the whole row onto a lighter grey in bold. The status line ends
# on every colour in RAINBOW order, one cell each.
# Values are (8-colour fallback, 256-colour index or None).
SESSION_COLOR = {
    "red": (curses.COLOR_RED, None), "green": (curses.COLOR_GREEN, None),
    "yellow": (curses.COLOR_YELLOW, None), "blue": (curses.COLOR_BLUE, None),
    "cyan": (curses.COLOR_CYAN, None), "purple": (curses.COLOR_MAGENTA, None),
    "orange": (curses.COLOR_YELLOW, 208), "pink": (curses.COLOR_MAGENTA, 205),
}
RAINBOW = ("red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink")
STATE_COLOR = {
    "blocked": curses.COLOR_YELLOW, "done": curses.COLOR_GREEN,
    "failed": curses.COLOR_RED, "error": curses.COLOR_RED,
    "killed": curses.COLOR_RED,
}
# The highlight grey, and what stands in for it without 256 colours.
SEL_BG = 237
# While a filter is on, both bars turn green, or red when nothing
# matches, so the eye finds the header that says how to clear it.

# One source for the ? panel and for --keys, so a new binding is written
# down once. (group, ((keys, what), ...)).
HELP = (
    ("move", (("\u2191 \u2193    j k", "highlight a row"),
              ("g    G", "first row, last row"))),
    ("order", (("\u21e7\u2191 \u21e7\u2193   J K", "move the row in its section or group"),)),
    ("group", (("^s", "group by cwd, or back to recency"),
               ("enter", "fold or unfold the group or section"),
               ("-    +", "fold all, unfold all"))),
    ("park", (("space", "park or unpark the row"),
              ("A", "park every shown row"),
              ("U", "unpark every shown row"))),
    ("delete", (("^x", "drop the job record, keep the transcript"),)),
    ("find", (("f", "filter on name, id, cwd or state"),
              ("esc", "clear the filter"))),
    ("other", (("r", "reload from disk"),
               ("h    ?", "the key panel"),
               ("q", "quit"))),
)


def help_lines():
    kw = max(len(k) for _, pairs in HELP for k, _ in pairs)
    out = []
    for group, pairs in HELP:
        if out:
            out.append("")
        for i, (keys, what) in enumerate(pairs):
            out.append("%-7s %-*s  %s" % (group if i == 0 else "", kw, keys, what))
    return out


# Some terminals send CSI cursor keys while terminfo declares SS3 ones (or
# the reverse), so curses hands back a bare ESC and the tail as plain bytes.
# read_key() reassembles those itself instead of treating ESC as a keypress.
ESC_SEQS = {
    "[A": curses.KEY_UP, "OA": curses.KEY_UP,
    "[B": curses.KEY_DOWN, "OB": curses.KEY_DOWN,
    "[C": curses.KEY_RIGHT, "OC": curses.KEY_RIGHT,
    "[D": curses.KEY_LEFT, "OD": curses.KEY_LEFT,
    "[H": curses.KEY_HOME, "OH": curses.KEY_HOME, "[1~": curses.KEY_HOME,
    "[F": curses.KEY_END, "OF": curses.KEY_END, "[4~": curses.KEY_END,
    # PgUp and PgDn do nothing, but they are decoded so that a stray
    # fn+arrow is swallowed instead of arriving as a bare ESC.
    "[5~": curses.KEY_PPAGE, "[6~": curses.KEY_NPAGE,
    # Shift+Up/Down. xterm-style modifiers first, then rxvt's short form.
    # KEY_SR/KEY_SF are what terminfo calls them, so the handler needs one
    # name for both routes.
    "[1;2A": curses.KEY_SR, "[1;2B": curses.KEY_SF,
    "[a": curses.KEY_SR, "[b": curses.KEY_SF,
}


def read_key(win):
    c = win.getch()
    if c != 27:
        return c
    seq = ""
    win.nodelay(True)
    try:
        deadline = time.time() + 0.05
        while time.time() < deadline and len(seq) < 10:
            n = win.getch()
            if n == -1:
                time.sleep(0.004)
                continue
            seq += chr(n)
            if seq in ESC_SEQS:
                return ESC_SEQS[seq]
            if seq[-1].isalpha() or seq[-1] == "~":
                break
    finally:
        win.nodelay(False)
    if seq and seq[-1] in "ABCD":
        return ESC_SEQS.get("[" + seq[-1], 27)
    return 27


def parse_iso(s):
    if not s:
        return 0.0
    try:
        t = time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")
        return time.mktime(t) - time.timezone
    except Exception:
        return 0.0


def ago(ts):
    if not ts:
        return "-"
    d = max(0, time.time() - ts)
    for cut, unit, div in ((60, "s", 1), (3600, "m", 60), (86400, "h", 3600),
                           (604800, "d", 86400)):
        if d < cut:
            return "%d%s" % (int(d // div), unit)
    return "%dw" % int(d // 604800)


CTRL_S, CTRL_X = 19, 24


def read_saved():
    """The saved order and view. Missing or broken file means neither."""
    try:
        with open(ORDER) as fh:
            d = json.load(fh)
    except Exception:
        return {}
    return d if isinstance(d, dict) else {}


def write_saved(**changes):
    """Rewrite the file with changes on top, keeping every other key."""
    d = read_saved()
    d.update(changes)
    tmp = ORDER + ".tmp"
    try:
        with open(tmp, "w") as fh:
            json.dump(d, fh)
        os.replace(tmp, ORDER)
    except Exception as exc:
        return "could not save %s: %s" % ("/".join(changes), exc)
    return None


def load_order():
    """Map job id -> hand-placed rank. No saved order means no hand order."""
    ids = read_saved().get("order") or []
    return {k: i for i, k in enumerate(ids) if isinstance(k, str)}


def save_order(entries):
    """Snapshot the whole list. Ids that no longer exist are dropped."""
    return write_saved(order=[e["short"] for e in entries])


def tilde(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def grouped_rows(shown, folded):
    """Each section split by cwd, a title row above every group.

    Groups keep the order their first session has in the list, and the
    sessions in a group keep theirs, so hand order and recency both still
    count. A folded group keeps its title row and hides the rest.
    """
    out = []
    for parked in (False, True):
        order, by = [], {}
        for e in shown:
            if e["parked"] != parked:
                continue
            if e["cwd"] not in by:
                by[e["cwd"]] = []
                order.append(e["cwd"])
            by[e["cwd"]].append(e)
        for cwd in order:
            key = ("parked:" if parked else "visible:") + cwd
            is_open = key not in folded
            out.append({"kind": "group", "key": key, "parked": parked,
                        "cwd": cwd, "label": tilde(cwd) or "(no cwd)",
                        "n": len(by[cwd]), "open": is_open})
            if is_open:
                out.extend(by[cwd])
    return out


def section_rows(shown, folded):
    """The recency view. A title row above the visible and parked halves."""
    out = []
    for parked in (False, True):
        sec = [e for e in shown if e["parked"] == parked]
        if not sec:
            continue
        label = "parked" if parked else "visible"
        key = "section:" + label
        is_open = key not in folded
        out.append({"kind": "section", "key": key, "parked": parked,
                    "cwd": None, "label": label, "n": len(sec),
                    "open": is_open})
        if is_open:
            out.extend(sec)
    return out


def load():
    out = []
    for base, parked in ((JOBS, False), (PARK, True)):
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            sf = os.path.join(d, "state.json")
            if not os.path.isdir(d) or not os.path.isfile(sf):
                continue
            try:
                with open(sf) as fh:
                    st = json.load(fh)
            except Exception:
                st = {}
            state = st.get("state") or "?"
            label = st.get("name") or (st.get("intent") or "")[:48] or name
            out.append({
                "short": name,
                "dir": d,
                "parked": parked,
                "state": state,
                "live": state not in TERMINAL,
                "name": label,
                "color": st.get("color") or "",
                "cwd": st.get("cwd") or "",
                "session": st.get("sessionId") or "",
                "ts": parse_iso(st.get("updatedAt") or st.get("createdAt")),
            })
    rank = load_order()
    out.sort(key=lambda e: (e["parked"],
                            1 if e["short"] in rank else 0,
                            rank.get(e["short"], -e["ts"])))
    return out


def move(entries, rows, sel, delta):
    """Swap the highlighted row with its neighbour in the visible list.

    Under a filter the neighbour is the next *shown* row, so the entry
    hops over anything hidden. What you see is what moves. Only entries
    is reordered; rows is rebuilt by the draw loop on the next pass.
    """
    tgt = sel + delta
    if not rows:
        return sel, "nothing to move"
    if tgt < 0 or tgt >= len(rows):
        return sel, "already at the %s" % ("top" if delta < 0 else "bottom")
    a, b = rows[sel], rows[tgt]
    if a.get("kind"):
        return sel, "a title row does not move. enter folds it"
    if b.get("kind") == "section":
        return sel, "reorder stays in one section. space parks or unparks"
    if b.get("kind"):
        # Title rows sit between groups, so this is the edge of one.
        return sel, "reorder stays in its group"
    if a["parked"] != b["parked"]:
        return sel, "reorder stays in one section. space parks or unparks"
    i, j = entries.index(a), entries.index(b)
    entries[i], entries[j] = entries[j], entries[i]
    err = save_order(entries)
    return tgt, err or ("moved %s %s"
                        % (a["short"], "up" if delta < 0 else "down"))


def toggle(entry):
    """Move a job record between the live and parked stores."""
    dest_base = JOBS if entry["parked"] else PARK
    if not os.path.isdir(dest_base):
        os.makedirs(dest_base)
    dest = os.path.join(dest_base, entry["short"])
    if os.path.exists(dest):
        return "%s already exists in %s" % (entry["short"], dest_base)
    os.rename(entry["dir"], dest)
    return None


def recheck(shorts):
    """Undo any park the daemon reversed. Returns a status or None.

    A session the daemon still holds gets a fresh stub record in JOBS the
    moment its folder leaves, so a park would show the same session twice.
    Give the daemon a beat, then drop the stub and put the real record back.
    """
    if not shorts:
        return None
    time.sleep(1)
    back, errs = [], []
    for s in shorts:
        stub = os.path.join(JOBS, s)
        if not os.path.exists(stub):
            continue
        try:
            shutil.rmtree(stub)
            os.rename(os.path.join(PARK, s), stub)
        except Exception as exc:
            errs.append("could not restore %s: %s" % (s, exc))
            continue
        back.append(s)
    if errs:
        return ". ".join(errs)
    if back:
        return ("daemon still holds %s. left it visible. stop it, then park"
                % " ".join(back))
    return None


def remove(entry):
    """Delete a job record. Only the record, and only from the two stores.

    The transcript under ~/.claude/projects is a separate tree and is not
    touched, so `claude --resume <session-id>` still works afterwards.
    """
    d = os.path.realpath(entry["dir"])
    if not any(d.startswith(os.path.realpath(b) + os.sep) for b in (JOBS, PARK)):
        return "%s sits outside the job stores. not deleting" % entry["short"]
    try:
        shutil.rmtree(d)
    except Exception as exc:
        return "could not delete %s: %s" % (entry["short"], exc)
    return None


def short_cwd(p):
    if p.startswith(HOME):
        p = "~" + p[len(HOME):]
    parts = [x for x in p.split("/") if x]
    return "/".join(parts[-2:]) if len(parts) > 2 else p


def plain(entries):
    print("%-9s %-8s %-9s %-30s %-28s %s"
          % ("VIS", "ID", "STATE", "NAME", "CWD", "AGE"))
    for e in entries:
        print("%-9s %-8s %-9s %-30s %-28s %s"
              % ("parked" if e["parked"] else "visible", e["short"],
                 e["state"], e["name"][:30], short_cwd(e["cwd"])[:28],
                 ago(e["ts"])))


def fits(s, n):
    return s if len(s) <= n else s[:max(0, n - 1)] + "…"


def pad(s, n):
    """Trim or space-fill to exactly n cells.

    Every drawn line is padded so each frame rewrites whole rows. Without
    this, a shorter line leaves the tail of the previous frame on screen
    when the terminal does not honour the erase curses emits for it.
    """
    n = max(0, n)
    return (s[:n] if len(s) > n else s).ljust(n)


def help_panel(stdscr):
    """Show the key list over the list, and return a key to act on.

    Anything but esc, q and enter is handed back to the caller's handler,
    so reading a key and using it are the same gesture. -1 means the panel
    was only dismissed. It scrolls when it does not all fit, because a
    short terminal would otherwise drop the last groups with nothing on
    screen to say they exist.
    """
    body = help_lines()
    off = 0
    while True:
        h, w = stdscr.getmaxyx()
        pw = min(max(len(r) for r in body) + 4, max(24, w - 2))
        ph = min(len(body) + 5, max(7, h - 2))
        shown = ph - 5
        off = max(0, min(off, len(body) - shown))
        more = len(body) > shown
        win = curses.newwin(ph, pw, (h - ph) // 2, (w - pw) // 2)
        win.keypad(True)
        win.erase()
        win.box()
        win.addstr(0, 2, " claude-park keys ", curses.A_BOLD)
        # Padded for the same reason the list rows are: a scroll redraws
        # over the old frame, and a shorter line would leave its tail.
        for i, line in enumerate(body[off:off + shown]):
            win.addstr(2 + i, 2, pad(fits(line, pw - 4), pw - 4))
        foot = "esc closes   any other key runs it"
        if more:
            foot = "\u2191\u2193 scroll   %d of %d   %s" % (
                off + shown, len(body), foot)
        win.addstr(ph - 2, 2, pad(fits(foot, pw - 4), pw - 4), curses.A_DIM)
        # A scroll shifts most of the panel at once, and curses answers
        # that with a scroll region spanning the whole line, which drags
        # the list underneath along with it. redrawwin() drops its record
        # of these rows so the frame is repainted outright.
        win.redrawwin()
        win.refresh()
        c = read_key(win)
        if more and c in (curses.KEY_DOWN, ord("j")):
            off += 1
        elif more and c in (curses.KEY_UP, ord("k")):
            off -= 1
        elif c in (27, ord("q"), ord("h"), ord("?"), 10, 13, curses.KEY_ENTER):
            return -1
        else:
            return c


def run(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    if hasattr(curses, "set_escdelay"):
        curses.set_escdelay(25)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()

    pairs = {}

    def pair(fg, bg):
        """A colour pair for fg on bg, made the first time it is asked for."""
        if not curses.has_colors():
            return 0
        if (fg, bg) not in pairs:
            n = len(pairs) + 1
            if n >= curses.COLOR_PAIRS:
                return 0
            curses.init_pair(n, fg, bg)
            pairs[(fg, bg)] = n
        return curses.color_pair(pairs[(fg, bg)])

    def rich():
        return curses.has_colors() and curses.COLORS >= 256

    def bar_attr(filtering, matched=True):
        if not filtering:
            return curses.A_REVERSE
        if not curses.has_colors():
            return curses.A_REVERSE | curses.A_BOLD
        bg = curses.COLOR_GREEN if matched else curses.COLOR_RED
        return pair(curses.COLOR_BLACK, bg) | curses.A_BOLD

    def plain_attr(item, selected):
        """Plain cells. Parked rows are dim until the highlight lifts them."""
        base = curses.A_BOLD if item.get("short") == SELF else 0
        bg = -1
        if selected:
            base |= curses.A_BOLD
            if rich():
                bg = SEL_BG
            else:
                base |= curses.A_REVERSE
        elif item["parked"]:
            base |= curses.A_DIM
        return base, base | pair(-1, bg)

    def swatch(name):
        """A cell painted in a session colour, or None without one."""
        col = SESSION_COLOR.get(name)
        if not col or not curses.has_colors():
            return None
        c = col[1] if col[1] is not None and rich() else col[0]
        return pair(curses.COLOR_BLACK, c)

    def row_attrs(e, selected):
        """Attributes for plain cells, the state word and the colour blip."""
        base, plain_a = plain_attr(e, selected)
        blip_a = swatch(e["color"]) or plain_a
        if e["parked"]:
            return plain_a, plain_a, blip_a
        sc = STATE_COLOR.get(e["state"])
        state_a = plain_a
        if sc is not None:
            state_a = base | pair(sc, SEL_BG if selected and rich() else -1)
        if e["state"] == "working":
            state_a |= curses.A_BOLD
        return plain_a, state_a, blip_a

    # Ctrl+S is XOFF to a terminal left in its default mode, which would
    # freeze the screen instead of reaching us. Flow control is switched
    # off for the session, and endwin() puts the terminal back as it was.
    try:
        import termios
        fd = sys.stdin.fileno()
        mode = termios.tcgetattr(fd)
        mode[0] &= ~termios.IXON
        termios.tcsetattr(fd, termios.TCSANOW, mode)
    except Exception:
        pass

    entries = load()
    saved = read_saved()
    grouped = bool(saved.get("grouped"))
    folded = set(k for k in saved.get("folded") or [] if isinstance(k, str))
    sel = 0
    want = None
    filt = ""
    status = "space parks or unparks   h lists every key"

    def ident(item):
        return item.get("key") or item["short"]

    def view():
        if not filt:
            return entries
        f = filt.lower()
        return [e for e in entries
                if f in e["name"].lower() or f in e["short"]
                or f in e["cwd"].lower() or f in e["state"]]

    def ask(win, prompt):
        h, w = win.getmaxyx()
        win.addstr(h - 1, 0, pad(prompt, w - 1), curses.A_REVERSE)
        win.refresh()
        return win.getch()

    while True:
        layout = grouped_rows if grouped else section_rows
        rows = layout(view(), folded)
        if want is not None:
            # Keep the highlight on the same row across a regroup.
            sel = next((i for i, r in enumerate(rows) if ident(r) == want), sel)
            want = None
        if sel >= len(rows):
            sel = max(0, len(rows) - 1)
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        nvis = sum(1 for e in entries if not e["parked"])
        npark = len(entries) - nvis
        nshown = len(view())
        if filt:
            head = (" claude-park   filter: %s   esc to clear   %d of %d shown"
                    % (filt, nshown, len(entries)))
        else:
            head = " claude-park   %d visible   %d parked" % (nvis, npark)
        if grouped:
            head += "   by cwd"
        bar_a = bar_attr(bool(filt), nshown > 0)
        stdscr.addstr(0, 0, pad(head, w - 1), bar_a)

        name_w = max(12, int((w - 36) * 0.5))
        cwd_w = max(10, w - 36 - name_w)
        # Three spaces ahead of NAME cover the blip and the gap after it.
        stdscr.addstr(1, 3, pad("%-8s %-8s   %-*s %-*s %s"
                                % ("ID", "STATE", name_w, "NAME",
                                   cwd_w, "CWD", "AGE"), w - 4), curses.A_DIM)

        top = max(0, sel - (h - 6))
        y = 2
        drew_sep = False
        for i, e in enumerate(rows[top:], start=top):
            if y >= h - 2:
                break
            # The recency view's title rows already mark the split.
            if grouped and e["parked"] and not drew_sep:
                drew_sep = True
                stdscr.addstr(y, 2, pad("── parked "
                                        + "─" * w, w - 3), curses.A_DIM)
                y += 1
                if y >= h - 2:
                    break
            if e.get("kind"):
                _, a = plain_attr(e, i == sel)
                label = " %s %s  %d" % ("\u25be" if e["open"] else "\u25b8",
                                        e["label"], e["n"])
                stdscr.addstr(y, 1, pad(label, w - 2), a | curses.A_BOLD)
                y += 1
                continue
            mark = "·" if e["parked"] else "●"
            plain_a, state_a, blip_a = row_attrs(e, i == sel)
            cells = (
                (" %s %-8s " % (mark, e["short"]), plain_a),
                ("%-8s" % e["state"][:8], state_a),
                (" ", plain_a),
                (" ", blip_a),
                (" %-*s %-*s %s" % (name_w, fits(e["name"], name_w), cwd_w,
                                    fits(short_cwd(e["cwd"]), cwd_w),
                                    ago(e["ts"])), plain_a),
            )
            x, room = 0, w - 1
            for text, a in cells:
                text = text[:room - x]
                if text:
                    stdscr.addstr(y, x, text, a)
                    x += len(text)
            if x < room:
                stdscr.addstr(y, x, " " * (room - x), plain_a)
            y += 1

        while y < h - 2:
            stdscr.addstr(y, 0, pad("", w - 1))
            y += 1

        stdscr.addstr(h - 2, 1, pad(status, w - 2), curses.A_DIM)
        x = w - 2 - len(RAINBOW)
        if x > len(status) + 2:
            for name in RAINBOW:
                stdscr.addstr(h - 2, x, " ", swatch(name) or curses.A_DIM)
                x += 1
        # Only the keys worth a glance. ? carries the full list, so this
        # line stays short enough to survive a narrow terminal intact.
        keys = (" \u2191\u2193 move   \u21e7\u2191\u2193 reorder   space park   "
                "^s group   ^x delete   f filter   h keys   q quit ")
        if len(keys) > w - 1:
            keys = " \u2191\u2193 move  space park  ^s group  ^x delete  h keys  q quit "
        stdscr.addstr(h - 1, 0, pad(keys, w - 1), bar_a)
        stdscr.refresh()

        c = read_key(stdscr)
        if c in (ord("h"), ord("?")):
            c = help_panel(stdscr)
        if c == ord("q"):
            return
        elif c == 27:
            filt, sel, status = "", 0, "filter cleared"
        elif c in (curses.KEY_DOWN, ord("j")):
            sel = min(sel + 1, max(0, len(rows) - 1))
        elif c in (curses.KEY_UP, ord("k")):
            sel = max(sel - 1, 0)
        elif c in (curses.KEY_HOME, ord("g")):
            sel = 0
        elif c in (curses.KEY_END, ord("G")):
            sel = max(0, len(rows) - 1)
        elif c in (curses.KEY_SR, ord("K")):
            sel, status = move(entries, rows, sel, -1)
        elif c in (curses.KEY_SF, ord("J")):
            sel, status = move(entries, rows, sel, 1)
        elif c == ord("r"):
            entries = load()
            status = "reloaded"
        elif c == CTRL_S:
            grouped = not grouped
            if rows:
                cur = rows[sel]
                # Leaving the grouped view from a title row lands on the
                # group's first session.
                if cur.get("kind"):
                    cur = next((e for e in view() if e["parked"] == cur["parked"]
                                and cur["cwd"] in (None, e["cwd"])), cur)
                want = ident(cur)
            err = write_saved(grouped=grouped)
            # Most rows shift at once. Left to itself curses answers that
            # with a scroll region, so the frame is repainted outright.
            stdscr.clear()
            status = err or ("grouped by cwd. enter folds a group"
                             if grouped else "sorted by recency")
        elif c in (10, 13, curses.KEY_ENTER) and rows and rows[sel].get("kind"):
            g = rows[sel]
            folded ^= {g["key"]}
            err = write_saved(folded=sorted(folded))
            stdscr.clear()
            status = err or "%s %s" % ("unfolded" if g["key"] not in folded
                                       else "folded", g["label"])
        elif c in (ord("-"), ord("+"), ord("=")):
            # Every title row in this view, not just the filtered ones.
            keys = {r["key"] for r in layout(entries, set()) if r.get("kind")}
            if c == ord("-"):
                folded |= keys
                if rows:
                    # Land on the title row of the group the highlight was in.
                    want = next((ident(r) for r in reversed(rows[:sel + 1])
                                 if r.get("kind")), None)
            else:
                if rows:
                    want = ident(rows[sel])
                folded -= keys
            err = write_saved(folded=sorted(folded))
            stdscr.clear()
            status = err or ("folded all" if c == ord("-") else "unfolded all")
        elif c in (CTRL_X, ord(" ")) and rows and rows[sel].get("kind"):
            status = "that is a title row. enter folds it"
        elif c == CTRL_X and rows:
            e = rows[sel]
            if e["short"] == SELF:
                status = "refusing to delete this session's own record"
            elif ask(stdscr, " delete %s%s? the transcript stays. y/N "
                     % (e["short"], " while it is %s" % e["state"]
                        if e["live"] else "")) not in (ord("y"), ord("Y")):
                status = "kept %s" % e["short"]
            else:
                err = remove(e)
                status = err or "deleted %s" % e["short"]
                entries = load()
                # Prune the stale id, but only from an order the user has
                # already made. A delete should not pin an unsorted list.
                if not err and load_order():
                    save_order(entries)
        elif c == ord("f"):
            curses.echo()
            stdscr.addstr(h - 1, 0, " filter: ".ljust(w - 1), bar_attr(True))
            stdscr.move(h - 1, 9)
            try:
                filt = stdscr.getstr().decode("utf-8", "replace").strip()
            except Exception:
                filt = ""
            curses.noecho()
            sel = 0
        elif c == ord(" ") and rows:
            e = rows[sel]
            if e["short"] == SELF and not e["parked"]:
                status = "refusing to park this session's own record"
            elif e["live"] and not e["parked"] and ask(
                    stdscr, " %s is %s. Park anyway? y/N " % (e["short"], e["state"])
            ) not in (ord("y"), ord("Y")):
                status = "left %s alone" % e["short"]
            else:
                err = toggle(e)
                if not err and not e["parked"]:
                    err = recheck([e["short"]])
                status = err or ("%s %s" % (
                    "unparked" if e["parked"] else "parked", e["short"]))
                entries = load()
        elif c == ord("A"):
            # Shown means on screen, so a folded group is left alone.
            todo = [e for e in rows if not e.get("kind")
                    and not e["parked"] and e["short"] != SELF]
            if not todo:
                status = "nothing to park"
            elif ask(stdscr, " Park %d sessions? y/N " % len(todo)) in (
                    ord("y"), ord("Y")):
                done = [e["short"] for e in todo if toggle(e) is None]
                err = recheck(done)
                entries = load()
                status = err or "parked %d" % len(done)
        elif c == ord("U"):
            todo = [e for e in rows if not e.get("kind") and e["parked"]]
            if not todo:
                status = "nothing parked"
            elif ask(stdscr, " Unpark %d sessions? y/N " % len(todo)) in (
                    ord("y"), ord("Y")):
                for e in todo:
                    toggle(e)
                entries = load()
                status = "unparked %d" % len(todo)


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__)
        print("keys\n")
        for line in help_lines():
            print("  " + line if line else "")
        return
    if "--keys" in args:
        for line in help_lines():
            print(line)
        return
    if "--list" in args or not sys.stdout.isatty():
        plain(load())
        return
    curses.wrapper(run)


if __name__ == "__main__":
    main()
