#!/usr/bin/env python3
"""palette-pick — pick a few hues, decide how each varies, get a palette.

  palette-pick [options]

  -t, --title TEXT    say what the palette is for, on the top line
      --theme NAME    start from this theme (see --themes)
      --hues LIST     the hues, 1 to 6, as degrees or hex: '#0c46df,#066a63,#eef434'
                      (a hex sets lightness and chroma too; 2 or 3 usually read best)
      --harmony NAME  how shuffles space the hues (see --themes)
      --members N     colours per family, 1 to 5 (default 3)
  -n, --steps N       steps in the JSON gradient, 2 to 16 (default 6)
  -f, --format FMT    json (the default), hex (a family a line) or css
  -o, --out FILE      also write the palette as JSON on every change
  -x, --xterm         snap every colour to the xterm-256 colour a TUI draws
      --print         print the palette for the options given, no picker
      --themes        list the themes and harmonies, then exit
      --tab           pick in a new Ghostty tab, and this process waits
      --split         the same, in a split to the right
      --nested        the caller already holds the alternate screen

Enter prints the palette and exits 0. Esc or q prints nothing and exits 1.
A usage error exits 2. With no --theme or --hues it opens on your last pick.

Three sections, top to bottom.

1 hues: the bases, picked by hand. Up to 6, though 2 or 3 usually read
best. Each row shows the base as picked, with its hex, hue, lightness and
chroma, then the family and shades it makes. On a hue row, ← → turns the
hue, [ ] makes it lighter or darker, { } stronger or greyer, e picks it in
color-pick, # types a hex. a adds a hue, d drops one, 1 to 6 jump to one.

2 variance: how each hue becomes its family and shades. size is how many
colours a family has. siblings is how different neighbouring siblings
look: same lightness and chroma, turned in hue, leaning toward the next
family so the palette reads as one progression with clear divisions.
shades, drift and fade shape the darker and lighter shades of each base.

3 effects: on top of everything, and 0 is none. light, chroma, stagger,
a tint to mix toward, and lift and cap for the black and white points.

The palette row at the top shows every family in order. The line under
it says whether siblings tell apart and families stay further apart.

Space shuffles the hues within the harmony and S shuffles everything.
b steps back through shuffles. x on a hue row keeps it through shuffles.
0 sets the slider under the cursor to 0, and N sets every shades and
effects slider to 0. t and m step the theme and the harmony. < and > turn
every hue at once. # on the tint row sets the tint. w saves the sliders
as a theme of your own, in ~/.config/palette-pick/themes.json. c copies
the output, r resets.
"""

import base64
import json
import math
import os
import random
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty

HOME = os.path.expanduser("~")
STATE = os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state"))
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
LAST = os.path.join(STATE, "palette-pick", "last.json")
USER_THEMES = os.path.join(CONFIG, "palette-pick", "themes.json")

BOLD, DIM, REV, RED = "\x1b[1m", "\x1b[2m", "\x1b[7m", "\x1b[31m"
MAX_W, MIN_W = 76, 56
VARIANTS = 9
CLOSE = 3.0          # steps nearer than this, in OKLab ΔE×100, read as one colour


# --- rules ------------------------------------------------------------------
# A neutral base is its hue at OKLCH lightness NEUTRAL_L and chroma
# NEUTRAL_C, ×100. A theme is effects on top, and 0 is always none. L and
# C shift lightness and chroma. stagger lifts the first base and drops the
# last, so the gradient also runs light to dark. spread, drift and fade
# open the variants: how far their lightness reaches, how far their hue
# turns, how much chroma the ends lose. mix pulls toward tint. lift and cap
# move the black and white points in.

NEUTRAL_L, NEUTRAL_C = 70, 14

# The basics. Each base hue heads a family: the base and its siblings, the
# same lightness and chroma turned apart in hue, ordered so each family
# leans toward the next. SIBLING is how different neighbouring siblings
# look, in ΔE: a grey-ish family turns further in hue than a vivid one to
# look as different. Families stay clearly apart, siblings stay related.
MEMBERS, SIBLING = 3, 6
NEUTRAL_SPREAD = 14     # neutral variants: plain shades and tints, this far in L each way

THEMES = {
    "neutral": dict(L=0,   C=0,  stagger=0,  spread=0,  drift=0,  fade=0,  tint="#ffffff", mix=0,  lift=0,  cap=0),
    "pastel":  dict(L=15,  C=-5, stagger=8,  spread=-4, drift=8,  fade=40, tint="#ffffff", mix=8,  lift=0,  cap=0),
    "soft":    dict(L=5,   C=-2, stagger=6,  spread=0,  drift=6,  fade=30, tint="#ffffff", mix=0,  lift=0,  cap=0),
    "neon":    dict(L=2,   C=16, stagger=0,  spread=2,  drift=12, fade=15, tint="#ffffff", mix=0,  lift=0,  cap=0),
    "jewel":   dict(L=-18, C=3,  stagger=6,  spread=4,  drift=8,  fade=10, tint="#ffffff", mix=0,  lift=0,  cap=0),
    "muted":   dict(L=-7,  C=-7, stagger=8,  spread=2,  drift=4,  fade=20, tint="#808080", mix=6,  lift=16, cap=15),
    "earth":   dict(L=-12, C=-4, stagger=10, spread=4,  drift=10, fade=25, tint="#8a6a48", mix=16, lift=0,  cap=0),
    "film":    dict(L=-3,  C=-3, stagger=6,  spread=2,  drift=6,  fade=20, tint="#f0e0c0", mix=8,  lift=28, cap=23),
    "dusk":    dict(L=-24, C=-2, stagger=8,  spread=0,  drift=-8, fade=20, tint="#2a2050", mix=10, lift=0,  cap=0),
}

# Hue offsets in degrees from a root. A shuffle picks a root, a harmony
# when none is set, a direction, and a few degrees of jitter. Past three
# hues the wheel gets crowded, so those only space evenly.
HARMONIES = {
    1: {"one": (0,)},
    2: {"wide": (0, 100), "split": (0, 150), "opposite": (0, 180)},
    3: {"fan": (0, 75, 150), "triad": (0, 120, 240), "split": (0, 150, 210)},
    4: {"even": (0, 90, 180, 270), "pairs": (0, 40, 180, 220)},
    5: {"even": (0, 72, 144, 216, 288)},
    6: {"even": (0, 60, 120, 180, 240, 300)},
}
MAX_HUES = 6
JITTER = 6

# The sliders, in two sections: (section, name, row label, lowest, highest,
# what it does). Variance turns each hue into its family and shades. The
# effects work on everything, and 0 is none. members and sibling live on
# the palette, the rest in the theme's knobs.
SLIDERS = (
    ("variance", "members", "size", 1, 5, "colours in each family: the base and its siblings"),
    ("variance", "sibling", "siblings", 0, 16, "how different neighbouring siblings look, in ΔE"),
    ("variance", "spread", "shades", -NEUTRAL_SPREAD, 26, "how far the shades of each base reach, darker and lighter"),
    ("variance", "drift", "drift", -45, 45, "shades turn hue toward their ends"),
    ("variance", "fade", "fade", 0, 100, "shades lose colour toward their ends"),
    ("effects", "L", "light", -45, 25, "every colour lighter or darker"),
    ("effects", "C", "chroma", -14, 23, "every colour stronger or greyer"),
    ("effects", "stagger", "stagger", -30, 30, "first family lighter, last family darker"),
    ("effects", "mix", "tint", 0, 60, "everything mixes toward the tint colour · # sets it"),
    ("effects", "lift", "lift", 0, 120, "blacks lift toward grey"),
    ("effects", "cap", "cap", 0, 120, "whites drop toward grey"),
)
ON_PALETTE = ("members", "sibling")


def slot(lo, hi, v, w):
    """The column for v on a w-wide slider. Zero sits mid-track when the knob
    goes both ways, at the left end when it only goes up."""
    if lo >= 0:
        return round((v - lo) * (w - 1) / (hi - lo))
    mid = (w - 1) // 2
    return mid + round(v * (w - 1 - mid) / hi) if v >= 0 else mid - round(v * mid / lo)


def base_lc(p, i, k):
    """Base i's lightness and chroma once the effects are on."""
    L, C = p.lc[i]
    n = len(p.hues)
    return L + k["L"] + (k["stagger"] * (0.5 - i / (n - 1)) if n > 1 else 0), C + k["C"]


def anchors(p):
    """Each base as (L, C, h), before tint and levels."""
    return [base_lc(p, i, p.knobs) + (p.hues[i],) for i in range(len(p.hues))]


def variant(p, i, t, knobs=None):
    """Base i moved t along its ramp, from −1 (dark end) to 1 (light end)."""
    k = knobs or p.knobs
    L, C = base_lc(p, i, k)
    L += (NEUTRAL_SPREAD + k["spread"]) * t
    C *= 1 - k["fade"] / 100 * abs(t)
    return paint(L, C, p.hues[i] + k["drift"] * t, k, p.snap)


def neutral(p, i):
    """Base i with no effects at all."""
    return paint(*p.lc[i], p.hues[i], THEMES["neutral"], p.snap)


def heading(hues, i):
    """+1 or −1: which way round the wheel the palette runs at hue i."""
    if len(hues) < 2:
        return 1
    a, b = (hues[i], hues[i + 1]) if i + 1 < len(hues) else (hues[i - 1], hues[i])
    return 1 if (b - a) % 360 < 180 else -1


def families(p):
    """Each base and its siblings, ordered along the palette's direction.
    Siblings turn as far as the siblings slider asks, unless that blurs one
    family into the next: then they are reined in, step by step."""
    for share in (None, 3, 4, 6):
        out = family_set(p, share)
        if judge(out)[2]:
            break
    return out


def family_set(p, share):
    """families(), with each outermost sibling kept within 1/share of the
    hue gap to the nearest family (no limit when share is None)."""
    k, m = p.knobs, p.members
    out = []
    for i, h in enumerate(p.hues):
        L, C = base_lc(p, i, k)
        gaps = [abs((p.hues[j] - h + 180) % 360 - 180) for j in (i - 1, i + 1) if 0 <= j < len(p.hues)]
        reach = min(gaps or [240]) / share / max(1, (m - 1) / 2) if share else 180
        turn = heading(p.hues, i) * min(sibling_turn(p.sibling, C), reach)
        out.append([paint(L, C, h + turn * (j - (m - 1) / 2), k) for j in range(m)])
    if p.snap:
        flat = snap_apart([c for f in out for c in f])
        out = [flat[i * m:(i + 1) * m] for i in range(len(out))]
    return out


def sibling_turn(target, C):
    """Degrees of hue that move a colour of chroma C by target ΔE."""
    return math.degrees(2 * math.asin(min(1, target / (2 * max(C, 1))))) if target else 0


def judge(fams):
    """How the families read: (siblings' nearest ΔE, families' nearest ΔE, good).
    Good: siblings tell apart, and the nearest two families sit further apart
    than the nearest two siblings."""
    sib = [delta(a, b) for f in fams for a, b in zip(f, f[1:])]
    cross = min((delta(a, b) for i, f in enumerate(fams) for g in fams[i + 1:] for a in f for b in g), default=99)
    near = min(sib) if sib else 99
    return near, cross, near >= CLOSE and cross >= max(2 * CLOSE, 1.25 * near)


def gradient(p):
    """p.steps colours through the bases, hue by the short way round."""
    a, out = anchors(p), []
    if len(a) == 1:
        a = a * 2
    for s in range(p.steps):
        u = s * (len(a) - 1) / (p.steps - 1)
        j = min(int(u), len(a) - 2)
        f = u - j
        (L0, C0, h0), (L1, C1, h1) = a[j], a[j + 1]
        dh = (h1 - h0 + 180) % 360 - 180
        out.append(paint(L0 + (L1 - L0) * f, C0 + (C1 - C0) * f, h0 + dh * f, p.knobs))
    return snap_apart(out) if p.snap else out


def snap_apart(colours):
    """Each colour to its nearest xterm-256 colour, none used twice, so steps
    that were apart in full colour stay apart on a 256-colour screen."""
    if not LAB256:
        LAB256.update((h, lab(h)) for h in XTERM256)
    used, out = set(), []
    for h in colours:
        here = lab(h)
        pick = min((c for c in XTERM256 if c not in used), key=lambda c: math.dist(here, LAB256[c]))
        used.add(pick)
        out.append(pick)
    return out


def paint(L, C, h, k, snap=False):
    """One colour through the theme: OKLCH into gamut, tint, levels, snap."""
    r, g, b = lch_rgb(max(0, min(100, L)) / 100, max(0, C) / 100, h)
    m, t = k["mix"] / 100, rgb(k["tint"])
    lo, hi = k["lift"], 255 - k["cap"]
    out = tuple(round(lo + (v + (tv - v) * m) * (hi - lo) / 255) for v, tv in zip((r, g, b), t))
    return xterm(hexof(*out)) if snap else hexof(*out)


# --- colour -----------------------------------------------------------------

def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexof(r, g, b):
    return "#%02x%02x%02x" % (r, g, b)


def norm(v):
    """#rrggbb from #rgb, rrggbb, 0xrrggbb and the like, or None."""
    v = v.strip().strip("\"'").lower()
    v = v[2:] if v.startswith("0x") else v.lstrip("#")
    if re.fullmatch(r"[0-9a-f]{3}", v):
        v = "".join(ch * 2 for ch in v)
    return "#" + v if re.fullmatch(r"[0-9a-f]{6}", v) else None


def lin(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def unlin(c):
    c = max(0.0, min(1.0, c))
    return round(255 * (12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055))


def lab(h):
    """OKLab of a hex colour."""
    r, g, b = (lin(v) for v in rgb(h))
    l, m, s = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b,
               0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b,
               0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def hue_of(h):
    _, a, b = lab(h)
    return round(math.degrees(math.atan2(b, a))) % 360


def linear_rgb(L, C, h):
    a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
    l, m, s = ((L + 0.3963377774 * a + 0.2158037573 * b) ** 3,
               (L - 0.1055613458 * a - 0.0638541728 * b) ** 3,
               (L - 0.0894841775 * a - 1.2914855480 * b) ** 3)
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def lch_rgb(L, C, h):
    """OKLCH to sRGB. Out of gamut, chroma gives way and hue and lightness hold."""
    inside = lambda c: all(-1e-4 <= v <= 1 + 1e-4 for v in linear_rgb(L, c, h))
    if not inside(C):
        lo, hi = 0.0, C
        for _ in range(16):
            mid = (lo + hi) / 2
            lo, hi = (mid, hi) if inside(mid) else (lo, mid)
        C = lo
    return tuple(unlin(v) for v in linear_rgb(L, C, h))


def delta(a, b):
    return 100 * math.dist(lab(a), lab(b))


STEPS = (0, 95, 135, 175, 215, 255)


XTERM256 = [hexof(r, g, b) for r in STEPS for g in STEPS for b in STEPS] + \
    [hexof(*(8 + 10 * i,) * 3) for i in range(24)]
LAB256 = {}


def xterm(h):
    """The colour xterm-256 draws for h, as hex."""
    r, g, b = rgb(h)
    near = lambda v: min(range(6), key=lambda i: abs(STEPS[i] - v))
    cube = tuple(STEPS[near(v)] for v in (r, g, b))
    gv = 8 + 10 * min(range(24), key=lambda i: abs(8 + 10 * i - (r + g + b) // 3))
    err = lambda c: sum((x - y) ** 2 for x, y in zip(c, (r, g, b)))
    return hexof(*(cube if err(cube) <= err((gv,) * 3) else (gv,) * 3))


def FG(h):
    return "\x1b[38;2;%d;%d;%dm" % rgb(h)


def BG(h):
    return "\x1b[48;2;%d;%d;%dm" % rgb(h)


def ink(h):
    """Black or white, whichever reads on h."""
    r, g, b = rgb(h)
    return "#000000" if 0.299 * r + 0.587 * g + 0.114 * b > 140 else "#ffffff"


# --- the palette ------------------------------------------------------------

def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_atomic(path, text):
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".palette-pick.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def all_themes():
    """The built-in themes, then yours on top."""
    out = {k: dict(v) for k, v in THEMES.items()}
    for name, knobs in load_json(USER_THEMES).items():
        if isinstance(knobs, dict):
            base = dict(THEMES["neutral"])
            base.update({k: v for k, v in knobs.items() if k in base})
            out[name] = base
    return out


class Palette:
    def __init__(self, hues, theme, harmony, steps, snap, knobs=None, themes=None):
        self.themes = themes or all_themes()
        self.hues = [h % 360 for h in hues]
        self.lc = [[NEUTRAL_L, NEUTRAL_C] for _ in self.hues]
        self.members, self.sibling = MEMBERS, SIBLING
        self.theme = theme
        self.knobs = dict(knobs or self.themes[theme])
        self.harmony = harmony
        self.steps = steps
        self.snap = snap
        self.locks = set()

    def state(self):
        return dict(hues=list(self.hues), lc=[list(x) for x in self.lc], theme=self.theme,
                    harmony=self.harmony, knobs=dict(self.knobs), steps=self.steps,
                    members=self.members, sibling=self.sibling, locks=set(self.locks))

    def restore(self, s):
        for k, v in s.items():
            setattr(self, k, list(v) if k == "hues" else [list(x) for x in v] if k == "lc" else
                    dict(v) if k == "knobs" else set(v) if k == "locks" else v)

    @property
    def tweaked(self):
        return self.knobs != self.themes.get(self.theme)

    def set_theme(self, name):
        self.theme, self.knobs = name, dict(self.themes[name])

    def add(self, after):
        """A new neutral hue after row `after`, in the widest gap on the wheel."""
        if len(self.hues) >= MAX_HUES:
            return False
        hs = sorted(self.hues)
        gaps = [((hs[(i + 1) % len(hs)] - h) % 360 or 360, h) for i, h in enumerate(hs)]
        size, start = max(gaps)
        self.hues.insert(after + 1, round(start + size / 2) % 360)
        self.lc.insert(after + 1, [NEUTRAL_L, NEUTRAL_C])
        self.locks = {i + (i > after) for i in self.locks}
        self.fit_harmony()
        return True

    def drop(self, i):
        if len(self.hues) <= 1:
            return False
        del self.hues[i], self.lc[i]
        self.locks = {j - (j > i) for j in self.locks if j != i}
        self.fit_harmony()
        return True

    def fit_harmony(self):
        if self.harmony not in HARMONIES[len(self.hues)]:
            self.harmony = "any"

    def shuffle(self, rng, tries=40):
        """A new set of hues. Sets whose families blur, or whose siblings do,
        are passed over, so what a shuffle lands on is one the rules call good."""
        best = None
        for i in range(len(self.hues)):
            if i not in self.locks:
                self.lc[i] = [NEUTRAL_L, NEUTRAL_C]
        for _ in range(tries):
            name = self.shuffle_once(rng)
            near, cross, good = judge(families(self))
            if good:
                return name
            score = min(near / CLOSE, cross / (2 * CLOSE))
            if not best or score > best[0]:
                best = (score, name, list(self.hues))
        self.hues = best[2]
        return best[1]

    def shuffle_once(self, rng):
        n = len(self.hues)
        name = self.harmony if self.harmony in HARMONIES[n] else rng.choice(list(HARMONIES[n]))
        offs = HARMONIES[n][name]
        sign = rng.choice((1, -1))
        held = sorted(self.locks)
        root = self.hues[held[0]] - sign * offs[held[0]] if held else rng.uniform(0, 360)
        for i in range(n):
            if i not in self.locks:
                jit = rng.uniform(-JITTER, JITTER) if offs[i] else 0
                self.hues[i] = round(root + sign * offs[i] + jit) % 360
        return name

    def shuffle_all(self, rng):
        self.set_theme(rng.choice(list(self.themes)))
        return self.shuffle(rng)

    def output(self):
        grad = gradient(self)
        bases = [variant(self, i, 0) for i in range(len(self.hues))]
        fams = families(self)
        near, cross, good = judge(fams)
        return {
            "families": fams,
            "palette": [c for f in fams for c in f],
            "members": self.members,
            "sibling": self.sibling,
            "min_sibling": round(near, 1),
            "min_family": round(cross, 1),
            "clear": good,
            "theme": self.theme + ("*" if self.tweaked else ""),
            "harmony": self.harmony,
            "hues": list(self.hues),
            "lc": [list(x) for x in self.lc],
            "knobs": dict(self.knobs),
            "xterm": self.snap,
            "bases": bases,
            "neutral": [neutral(self, i) for i in range(len(self.hues))],
            "gradient": grad,
            "variants": [[variant(self, i, -1 + 2 * j / (VARIANTS - 1)) for j in range(VARIANTS)]
                         for i in range(len(self.hues))],
            "min_step": round(min(delta(a, b) for a, b in zip(grad, grad[1:])), 1),
            "min_base": round(min((delta(a, b) for i, a in enumerate(bases) for b in bases[i + 1:]), default=99), 1),
        }

    def formatted(self, how):
        o = self.output()
        if how == "hex":
            return "\n".join(" ".join(f) for f in o["families"])
        if how == "css":
            lines = ["  --family%d-%d: %s;" % (i + 1, j + 1, h) for i, f in enumerate(o["families"])
                     for j, h in enumerate(f)]
            for i, vs in enumerate(o["variants"]):
                lines += ["  --hue%d-%d: %s;" % (i + 1, j, h) for j, h in enumerate(vs)]
            return ":root {\n" + "\n".join(lines) + "\n}"
        return json.dumps(o, indent=2)


# --- drawing ----------------------------------------------------------------

class Canvas:
    """A grid of (char, style) cells, flushed in one write so nothing tears."""

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.cells = [[(" ", "")] * w for _ in range(h)]

    def put(self, y, x, text, style="", limit=None):
        if not 0 <= y < self.h:
            return
        if limit is not None:
            text = text[:max(0, limit)]
        row = self.cells[y]
        for i, ch in enumerate(text):
            if 0 <= x + i < self.w:
                row[x + i] = (ch, style)

    def centred(self, w, h):
        big = Canvas(w, h)
        oy, ox = (h - self.h) // 2, (w - self.w) // 2
        for y, row in enumerate(self.cells):
            big.cells[oy + y][ox:ox + self.w] = row
        return big

    def render(self):
        out = ["\x1b[H"]
        for y, row in enumerate(self.cells):
            style = None
            for ch, st in row:
                if st != style:
                    out.append("\x1b[0m" + st)
                    style = st
                out.append(ch)
            out.append("\x1b[0m")
            if y < self.h - 1:
                out.append("\r\n")
        return "".join(out)


def box(c, y, x, w, h):
    c.put(y, x, "╭" + "─" * (w - 2) + "╮", DIM)
    for r in range(y + 1, y + h - 1):
        c.put(r, x, "│", DIM)
        c.put(r, x + w - 1, "│", DIM)
    c.put(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", DIM)


def cells(c, y, x, w, colours, mark=None, text=False):
    """colours side by side across w columns, the spare columns spread out."""
    n = len(colours)
    for j, v in enumerate(colours):
        a, b = x + j * w // n, x + (j + 1) * w // n
        label = v if text and b - a >= 9 else ("◆" if j == mark else "")
        c.put(y, a, label.center(b - a), BG(v) + FG(ink(v)))


# --- keys -------------------------------------------------------------------

SEQ = {"[A": "up", "[B": "down", "[C": "right", "[D": "left",
       "OA": "up", "OB": "down", "OC": "right", "OD": "left",
       "[1;2C": "S-right", "[1;2D": "S-left", "[1;2A": "up", "[1;2B": "down",
       "[Z": "S-tab"}
PLAIN = {"\r": "enter", "\n": "enter", "\t": "tab", "\x7f": "bs", "\x08": "bs",
         "\x03": "ctrl-c"}
CSI = re.compile(r"\x1b(\[[0-9;]*[A-Za-z~]|O[A-Za-z])")
PASTE_ON, PASTE_OFF = "\x1b[200~", "\x1b[201~"


def keys(data):
    s, i = data.decode("utf-8", "ignore"), 0
    while i < len(s):
        if s.startswith(PASTE_ON, i):
            end = s.find(PASTE_OFF, i)
            end = len(s) if end < 0 else end
            yield "paste:" + s[i + len(PASTE_ON):end]
            i = end + len(PASTE_OFF)
            continue
        m = CSI.match(s, i)
        if m:
            yield SEQ.get(m.group(1), "")
            i = m.end()
            continue
        yield "esc" if s[i] == "\x1b" else PLAIN.get(s[i], s[i])
        i += 1


def copy_text(text):
    """Into the clipboard: a native tool when there is one, else OSC 52."""
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=2)
                return ""
            except (OSError, subprocess.SubprocessError):
                pass
    return "\x1b]52;c;%s\a" % base64.b64encode(text.encode()).decode()


# --- app --------------------------------------------------------------------

class App:
    def __init__(self, pal, title, fmt, out_file, nested):
        self.tty = os.open("/dev/tty", os.O_RDWR)
        self.p = pal
        self.start = pal.state()
        self.title, self.fmt, self.out_file, self.nested = title, fmt, out_file, nested
        self.rng = random.Random()
        self.row = 0                      # an index into rows()
        self.back = []
        self.prompt = None                # (what, text) while typing
        self.msg = None
        self.result = None
        self.done = False

    def out(self, s):
        os.write(self.tty, s.encode())

    def say(self, text, style=""):
        self.msg = (text, style)

    def changed(self):
        if self.out_file:
            try:
                write_atomic(self.out_file, self.p.formatted("json") + "\n")
            except OSError as e:
                self.say(f"cannot write {self.out_file}: {e.strerror}", RED)

    def keep(self):
        """Mark a step b can go back to."""
        self.back = (self.back + [self.p.state()])[-50:]

    def rows(self):
        """Every row the cursor can stand on: each hue, then each slider."""
        return [("hue", i) for i in range(len(self.p.hues))] + [("slider", s) for s in SLIDERS]

    def here(self):
        rows = self.rows()
        self.row = max(0, min(self.row, len(rows) - 1))
        return rows[self.row]

    def hue_row(self):
        kind, what = self.here()
        return what if kind == "hue" else None

    def slider(self):
        kind, what = self.here()
        return what if kind == "slider" else None

    def value(self, name):
        return getattr(self.p, name) if name in ON_PALETTE else self.p.knobs[name]

    def set_value(self, name, v):
        if name in ON_PALETTE:
            setattr(self.p, name, v)
        else:
            self.p.knobs[name] = v

    # --- key handling -------------------------------------------------------

    def key(self, k):
        if k == "ctrl-c":
            self.done = True
            return
        if k.startswith("paste:"):
            m = re.search(r"#?\b([0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b", k[6:])
            if m:
                self.prompt = None
                self.take_hex(norm(m.group(1)))
            else:
                self.say("no hex colour in that paste", RED)
            return
        if self.prompt is not None:
            self.prompt_key(k)
            return
        self.msg = None
        k = {"h": "left", "j": "down", "k": "up", "l": "right", "H": "S-left", "L": "S-right"}.get(k, k)
        p, i = self.p, self.hue_row()
        if k == "enter":
            self.result = p.formatted(self.fmt)
            self.done = True
        elif k in ("esc", "q"):
            self.done = True
        elif k in ("up", "down", "tab", "S-tab"):
            self.row = (self.row + (1 if k in ("down", "tab") else -1)) % len(self.rows())
        elif k in "123456" and len(k) == 1:
            if int(k) <= len(p.hues):
                self.row = int(k) - 1
            else:
                self.say(f"there are {len(p.hues)} hues · a adds one")
        elif k in ("left", "right", "S-left", "S-right"):
            self.nudge((1 if k.endswith("right") else -1) * (10 if k.startswith("S-") else 1))
        elif k in ("[", "]", "{", "}") and i is not None:
            L, C = p.lc[i]
            if k in "[]":
                p.lc[i][0] = max(5, min(98, L + (2 if k == "]" else -2)))
            else:
                p.lc[i][1] = max(0, min(37, C + (1 if k == "}" else -1)))
            self.changed()
        elif k == "a":
            self.keep()
            at = i if i is not None else len(p.hues) - 1
            if p.add(at):
                self.row = at + 1
                self.say(f"hue {at + 2} added · 2 or 3 hues usually read best"
                         if len(p.hues) > 3 else f"hue {at + 2} added")
                self.changed()
            else:
                self.say(f"{MAX_HUES} hues at most")
        elif k == "d" and i is not None:
            self.keep()
            if p.drop(i):
                self.say(f"hue {i + 1} dropped · b brings it back")
                self.changed()
            else:
                self.say("one hue at least")
        elif k == "e" and i is not None:
            self.pick(i)
        elif k == "x" and i is not None:
            p.locks ^= {i}
            self.say(f"hue {i + 1} " + ("held through shuffles" if i in p.locks else "free"))
        elif k == " ":
            self.keep()
            name = p.shuffle(self.rng)
            self.say(f"{name} around {p.hues[0]}°" + (" · held hues kept" if p.locks else ""))
            self.changed()
        elif k == "S":
            self.keep()
            name = p.shuffle_all(self.rng)
            self.say(f"{p.theme}, {name}")
            self.changed()
        elif k == "b":
            if self.back:
                p.restore(self.back.pop())
                self.changed()
            else:
                self.say("nothing to go back to")
        elif k in ("t", "T"):
            self.keep()
            names = list(p.themes)
            j = names.index(p.theme) if p.theme in names else 0
            p.set_theme(names[(j + (1 if k == "t" else -1)) % len(names)])
            self.changed()
        elif k in ("m", "M"):
            names = ["any"] + list(HARMONIES[len(p.hues)])
            j = names.index(p.harmony) if p.harmony in names else 0
            p.harmony = names[(j + (1 if k == "m" else -1)) % len(names)]
            self.say(f"shuffles use {p.harmony}" + (" harmony" if p.harmony == "any" else ""))
        elif k in ("<", ">", ",", "."):
            p.hues = [(h + (10 if k in (">", ".") else -10)) % 360 for h in p.hues]
            self.changed()
        elif k == "0":
            sl = self.slider()
            if sl and sl[1] not in ON_PALETTE:
                self.set_value(sl[1], 0)
                self.say(f"{sl[2]} is 0")
                self.changed()
            else:
                self.say("0 is for the shades and effects sliders · N zeroes them all")
        elif k == "N":
            self.keep()
            p.set_theme("neutral")
            self.say("every shade and effect slider at 0: the hues as you picked them")
            self.changed()
        elif k == "8":
            p.snap = not p.snap
            self.say("snapped to xterm-256" if p.snap else "full colour")
            self.changed()
        elif k == "#":
            sl = self.slider()
            if i is not None or (sl and sl[1] == "mix"):
                self.prompt = ("hex", "")
            else:
                self.say("# works on a hue row or the tint row")
        elif k == "w":
            self.prompt = ("name", "" if p.theme in THEMES else p.theme)
        elif k == "c":
            self.out(copy_text(p.formatted(self.fmt)))
            self.say(f"copied the {self.fmt}")
        elif k == "r":
            self.keep()
            p.restore(self.start)
            self.say("back to the start")
            self.changed()

    def nudge(self, step):
        p, i, sl = self.p, self.hue_row(), self.slider()
        if i is not None:
            p.hues[i] = (p.hues[i] + 2 * step) % 360
        else:
            _, name, _, lo, hi, _ = sl
            self.set_value(name, max(lo, min(hi, self.value(name) + step)))
        self.changed()

    def pick(self, i):
        """Hand base i to color-pick, which takes this screen until it is done."""
        picker = shutil.which("color-pick") or os.path.join(HOME, "dotfiles", "bin", "color-pick")
        if not os.path.exists(picker):
            self.say("color-pick is not installed · # types a hex instead", RED)
            return
        was = neutral(self.p, i)
        r = subprocess.run([sys.executable, picker, "--nested", "-t", f"palette-pick: hue {i + 1}",
                            "-p", ",".join(neutral(self.p, j) for j in range(len(self.p.hues))), was],
                           stdout=subprocess.PIPE, text=True)
        v = norm(r.stdout.strip()) if r.returncode == 0 else None
        if v:
            self.keep()
            self.take_hex(v)
        else:
            self.say(f"hue {i + 1} unchanged")

    def take_hex(self, v):
        i, sl = self.hue_row(), self.slider()
        if i is not None:
            L, a, b = lab(v)
            self.p.hues[i] = hue_of(v)
            self.p.lc[i] = [round(100 * L), round(100 * math.hypot(a, b))]
            self.say(f"hue {i + 1} is now {v}")
        elif sl and sl[1] == "mix":
            self.p.knobs["tint"] = v
            self.say(f"tint is {v}")
        else:
            self.say("a hex goes on a hue row or the tint row", RED)
            return
        self.changed()

    def prompt_key(self, k):
        what, text = self.prompt
        if k == "esc":
            self.prompt = None
        elif k == "enter":
            if what == "hex":
                v = norm(text)
                if not v:
                    self.say(f"not a hex colour: {text}", RED)
                    return
                self.prompt = None
                self.take_hex(v)
            else:
                self.save_theme(text.strip())
        elif k == "bs":
            self.prompt = (what, text[:-1])
        elif len(k) == 1 and k.isprintable() and len(text) < 16:
            self.prompt = (what, text + k)

    def save_theme(self, name):
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name or ""):
            self.say("a theme name is lower case letters, digits, - and _", RED)
            return
        if name in THEMES:
            self.say(f"{name} is built in · pick another name", RED)
            return
        self.prompt = None
        saved = load_json(USER_THEMES)
        saved[name] = dict(self.p.knobs)
        try:
            write_atomic(USER_THEMES, json.dumps(saved, indent=2) + "\n")
        except OSError as e:
            self.say(f"cannot write {USER_THEMES}: {e.strerror}", RED)
            return
        self.p.themes[name] = dict(self.p.knobs)
        self.p.theme = name
        self.say(f"saved theme {name}")

    # --- layout -------------------------------------------------------------

    def height(self):
        n = len(self.p.hues)
        return 2 + 3 + 2 + n + (n < MAX_HUES) + 1 + 5 + 1 + 6 + 3 + 1

    def draw(self):
        tw, th = os.get_terminal_size(self.tty)
        w = min(tw, MAX_W)
        bh = self.height()
        if w < MIN_W or th < bh + 4:
            c = Canvas(tw, th)
            c.put(th // 2, 1, f"need {MIN_W}×{bh + 4} · now {tw}×{th}", DIM)
            self.out(c.render())
            return
        p, o = self.p, self.p.output()
        x, iw = 2, w - 4
        tx, tr = x + 11, iw - 11 - 6          # track start and width
        c = Canvas(w, bh + 4)
        here = self.here() if self.prompt is None else None

        c.put(0, 1, "palette-pick", BOLD)
        n = len(p.hues)
        right = f"{o['theme']} · {n} hue{'s' * (n > 1)} · {p.harmony}" + (" · xterm-256" if p.snap else "")
        if self.title:
            room = w - len(right) - 18
            title = self.title if len(self.title) <= room else self.title[:max(0, room - 1)] + "…"
            c.put(0, 13, " · " + title)
        c.put(0, w - 1 - len(right), right, BOLD)
        box(c, 1, 0, w, bh)

        # The palette: every family in order, a gap between families.
        fams, m = o["families"], p.members
        span = tr + 6 - (n - 1)
        c.put(2, x, "palette", DIM)
        for i, f in enumerate(fams):
            a, b = tx + i * span // n + i, tx + (i + 1) * span // n + i
            cells(c, 2, a, b - a, f, text=True)
            cells(c, 3, a, b - a, f)
        near, cross = o["min_sibling"], o["min_family"]
        verdict = "clear" if o["clear"] else "siblings blur" if near < CLOSE else "families too close"
        line = (f"siblings ΔE ≥ {near} · " if m > 1 else "") + \
            (f"families ΔE ≥ {cross} · " if n > 1 else "") + verdict
        c.put(4, tx, line, DIM if o["clear"] else RED, limit=tr + 6)

        # 1: the hues, each as picked, then the family and shades it makes.
        y = 6
        c.put(y, x, "1 hues", BOLD)
        c.put(y, x + 8, "each base as picked · its family · its shades", DIM)
        fw = min(4, max(1, (tr - 23) // (2 * m)))
        fx = tx + 9 + 14
        sx = fx + fw * m + 1
        for i in range(n):
            y += 1
            on = here == ("hue", i)
            lock = " x" if i in p.locks else ""
            c.put(y, x, ("› " if on else "  ") + f"{i + 1}{lock}", BOLD if on else DIM)
            base = neutral(p, i)
            c.put(y, tx, base.center(9), BG(base) + FG(ink(base)) + BOLD)
            L, C = p.lc[i]
            c.put(y, tx + 10, f"{p.hues[i]:>3}° L{L:<3}C{C}", BOLD if on else DIM)
            for j, v in enumerate(fams[i]):
                c.put(y, fx + j * fw, " " * fw, BG(v))
            cells(c, y, sx, tx + tr + 6 - sx, o["variants"][i])
        if n < MAX_HUES:
            y += 1
            c.put(y, tx, "a adds a hue · 2 or 3 usually read best" if n >= 3 else "a adds a hue", DIM)

        def meter(y, sl):
            sec, name, label, lo, hi, _ = sl
            on = here == ("slider", sl)
            v = self.value(name)
            c.put(y, x, ("› " if on else "  ") + label, BOLD if on else DIM)
            rest = lo if name in ON_PALETTE else max(lo, 0)
            zero, pos = slot(lo, hi, rest, tr), slot(lo, hi, v, tr)
            for j in range(tr):
                if j == pos:
                    ch, st = "●", BOLD if v != rest else DIM
                elif min(zero, pos) < j < max(zero, pos):
                    ch, st = "─", BOLD + FG("#ffffff")
                else:
                    ch, st = "┼" if j == zero and lo < 0 else "─", DIM
                c.put(y, tx + j, ch, st)
            text = str(v) if name in ON_PALETTE else (f"{v:+}" if v else "0")
            c.put(y, tx + tr + 1, text.rjust(4), BOLD if on else DIM)

        # 2: how each hue varies. 3: effects over everything.
        for sec, head, note in (("variance", "2 variance", "how each hue becomes its family and shades"),
                                ("effects", "3 effects", "on top of everything · 0 is none")):
            y += 2 if sec == "variance" else 1
            c.put(y, x, head, BOLD)
            c.put(y, x + len(head) + 2, note, DIM)
            for sl in SLIDERS:
                if sl[0] == sec:
                    y += 1
                    meter(y, sl)

        # What the row under the cursor does, and its keys.
        y += 2
        if here and here[0] == "hue":
            i = here[1]
            lines = [f"hue {i + 1}: ← → hue · [ ] lighter, darker · {{ }} stronger, greyer",
                     "e pick it in color-pick · # type a hex · x hold · a add · d drop"]
        elif here:
            sl = here[1]
            lines = [f"{sl[2]}: {sl[5]}"]
        else:
            lines = []
        for j, text in enumerate(lines):
            c.put(y + j, x, text, DIM, limit=iw)
        if here and here[0] == "slider" and here[1][1] == "mix":
            c.put(y, x + len(lines[0]) + 1, "  ", BG(p.knobs["tint"]))
        self.draw_footer(c, w, bh + 1)
        self.out(c.centred(tw, th).render())

    def draw_footer(self, c, w, y):
        if self.prompt is not None:
            what, text = self.prompt
            lead = "hex # " if what == "hex" else "save theme as "
            c.put(y, 1, lead, BOLD)
            c.put(y, 1 + len(lead), text)
            c.put(y, 1 + len(lead) + len(text), " ", REV)
            c.put(y + 1, 1, "enter ok · esc cancel", DIM)
            return
        if self.msg:
            c.put(y, 1, self.msg[0], self.msg[1], limit=w - 2)
            y += 1
        hints = ["enter done", "esc cancel", "1-6 a hue", "space shuffle", "S all", "b back",
                 "t theme", "m harmony", "N no effects", "0 zero", "<> turn all", "8 xterm",
                 "w save", "c copy", "r reset", "⇧ ×10"]
        line = ""
        for hint in hints:
            if len(line) + len(hint) + 3 > w - 2:
                c.put(y, 1, line, DIM)
                y, line = y + 1, ""
                if y >= c.h:
                    return
            line += (" · " if line else "") + hint
        c.put(y, 1, line, DIM)

    # --- loop ---------------------------------------------------------------

    def run(self):
        old = termios.tcgetattr(self.tty)
        self.out(("\x1b[2J" if self.nested else "\x1b[?1049h") + "\x1b[?25l\x1b[?7l\x1b[?2004h")
        tty.setraw(self.tty)
        self.changed()
        try:
            size, stale = None, True
            while not self.done:
                now = os.get_terminal_size(self.tty)
                if stale or now != size:
                    self.draw()
                    size, stale = now, False
                if select.select([self.tty], [], [], 0.25)[0]:
                    for k in keys(os.read(self.tty, 4096)):
                        self.key(k)
                        if self.done:
                            break
                    stale = True
        finally:
            termios.tcsetattr(self.tty, termios.TCSADRAIN, old)
            self.out("\x1b[?2004l\x1b[?7h\x1b[?25h" + ("\x1b[0m\x1b[2J\x1b[H" if self.nested else "\x1b[?1049l"))
            os.close(self.tty)
        if self.result:
            remember(self.p)
        elif self.out_file:
            self.p.restore(self.start)        # a cancel puts the live preview back
            self.changed()
        return self.result


def remember(p):
    s = p.state()
    s["locks"] = sorted(s["locks"])
    s["snap"] = p.snap
    try:
        write_atomic(LAST, json.dumps(s) + "\n")
    except OSError:
        pass


# --- another tab --------------------------------------------------------------

APPLESCRIPT = """
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to item 2 of argv
    set wait after command of cfg to false
    if item 1 of argv is "split" then
      split (focused terminal of selected tab of front window) direction right with configuration cfg
    else
      new tab in front window with configuration cfg
    end if
  end tell
end run
"""


def elsewhere(where, args):
    """Run the picker in a Ghostty tab or split and wait for its answer."""
    if sys.platform != "darwin" or not shutil.which("osascript"):
        die("palette-pick: --tab and --split need Ghostty on macOS")
    d = tempfile.mkdtemp(prefix="palette-pick.")
    answer = os.path.join(d, "answer")
    me = os.path.realpath(__file__)
    cmd = " ".join(shlex.quote(a) for a in [sys.executable, me, "--answer", answer] + args)
    r = subprocess.run(["osascript", "-e", APPLESCRIPT, where, cmd], capture_output=True, text=True)
    if r.returncode:
        shutil.rmtree(d, ignore_errors=True)
        die("palette-pick: could not open a Ghostty %s: %s" % (where, r.stderr.strip()))
    try:
        t0 = time.time()
        while not os.path.exists(answer):
            if not os.path.exists(answer + ".started") and time.time() - t0 > 10:
                die("palette-pick: the picker %s never started" % where)
            time.sleep(0.1)
        with open(answer) as f:
            return f.read().rstrip("\n") or None
    except KeyboardInterrupt:
        return None
    finally:
        shutil.rmtree(d, ignore_errors=True)


# --- main ---------------------------------------------------------------------

def die(msg):
    """Usage and setup errors exit 2, apart from a cancel's 1."""
    print(msg, file=sys.stderr)
    sys.exit(2)


def parse(argv):
    opts = {"title": None, "theme": None, "hues": None, "harmony": None, "steps": None, "members": None,
            "format": "json", "out": None, "xterm": False, "print": False, "where": None,
            "nested": False, "answer": None}
    takes = {"-t": "title", "--title": "title", "--theme": "theme", "--hues": "hues",
             "--harmony": "harmony", "-n": "steps", "--steps": "steps", "--members": "members", "-f": "format",
             "--format": "format", "-o": "out", "--out": "out", "--answer": "answer"}
    flags = {"-x": "xterm", "--xterm": "xterm", "--print": "print", "--nested": "nested"}
    rest, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if a == "--themes":
            for name, k in all_themes().items():
                print(f"{name:<10}" + " ".join(f"{n}={v}" for n, v in k.items()))
            for n, hs in HARMONIES.items():
                print(f"\n{n} hues: " + ", ".join(f"{h} {'/'.join(map(str, o))}" for h, o in hs.items()))
            sys.exit(0)
        if "=" in a and a.split("=", 1)[0] in takes:
            a, val = a.split("=", 1)
            argv = argv[:i] + [a, val] + argv[i + 1:]
        if a in takes:
            if i + 1 >= len(argv):
                die(f"palette-pick: {a} needs a value")
            opts[takes[a]] = argv[i + 1]
            if takes[a] != "answer":
                rest += [a, argv[i + 1]]
            i += 2
            continue
        if a in ("--tab", "--split"):
            opts["where"] = a[2:]
        elif a in flags:
            opts[flags[a]] = True
            rest.append(a)
        else:
            die(f"palette-pick: unknown option {a} · try --help")
        i += 1
    return opts, rest


def build(opts):
    """The palette to open on: the options given, over your last pick."""
    themes = all_themes()
    last = {} if opts["theme"] or opts["hues"] else load_json(LAST)
    theme = opts["theme"] or last.get("theme", "neutral").rstrip("*")
    if theme not in themes:
        if opts["theme"]:
            die(f"palette-pick: no theme {theme} · try --themes")
        theme = "neutral"
    hues = last.get("hues") or [255, 150, 70]
    lc = last.get("lc") if last.get("lc") and len(last["lc"]) == len(hues) else None
    if opts["hues"]:
        hues, lc = [], []
        for v in re.split(r"[\s,]+", opts["hues"].strip()):
            if re.fullmatch(r"-?\d+(\.\d+)?", v):
                hues.append(round(float(v)))
                lc.append([NEUTRAL_L, NEUTRAL_C])
            elif norm(v):                     # a hex sets the family's lightness and chroma too
                L, a, b = lab(norm(v))
                hues.append(hue_of(norm(v)))
                lc.append([round(100 * L), round(100 * math.hypot(a, b))])
            else:
                die(f"palette-pick: not a hue or hex colour: {v}")
        if not 1 <= len(hues) <= MAX_HUES:
            die(f"palette-pick: --hues takes 1 to {MAX_HUES}")
    harmony = opts["harmony"] or last.get("harmony", "any")
    if harmony != "any" and harmony not in HARMONIES[len(hues)]:
        if opts["harmony"]:
            die(f"palette-pick: no {len(hues)}-hue harmony {harmony} · try --themes")
        harmony = "any"
    steps = opts["steps"] or last.get("steps", 6)
    try:
        steps = int(steps)
    except ValueError:
        die("palette-pick: --steps takes a number")
    if not 2 <= steps <= 16:
        die("palette-pick: --steps is 2 to 16")
    if opts["format"] not in ("json", "hex", "css"):
        die("palette-pick: --format is json, hex or css")
    knobs = last.get("knobs") if last and not opts["theme"] else None
    if knobs and set(knobs) != set(themes[theme]):
        knobs = None
    p = Palette(hues, theme, harmony, steps, opts["xterm"] or bool(last.get("snap")), knobs, themes)
    p.locks = {i for i in last.get("locks", []) if i < len(hues)}
    if lc:
        p.lc = [list(x) for x in lc]
    p.sibling = int(last.get("sibling", SIBLING))
    p.members = int(opts["members"] or last.get("members", MEMBERS))
    if not 1 <= p.members <= 5:
        die("palette-pick: --members is 1 to 5")
    return p


def main():
    opts, rest = parse(sys.argv[1:])
    if opts["where"]:
        result = elsewhere(opts["where"], [a for a in rest if a != "--nested"])
    else:
        p = build(opts)
        if opts["print"]:
            print(p.formatted(opts["format"]))
            if opts["out"]:
                write_atomic(opts["out"], p.formatted("json") + "\n")
            return
        try:
            open("/dev/tty").close()
        except OSError:
            die("palette-pick: needs a terminal · or use --print")
        signal.signal(signal.SIGHUP, lambda *_: sys.exit(1))
        result = None
        if opts["answer"]:
            write_atomic(opts["answer"] + ".started", "")
        try:
            result = App(p, opts["title"], opts["format"], opts["out"], opts["nested"]).run()
        finally:
            if opts["answer"]:
                write_atomic(opts["answer"], (result or "") + "\n")
    if not result:
        sys.exit(1)
    print(result)


if __name__ == "__main__":
    main()
