#!/usr/bin/env python3
"""palette-pick — pick a few hues, one lightness range and a strength; get
a family of steps for each hue.

  palette-pick [options]

  -t, --title TEXT    say what the palette is for, on the top line
      --hues LIST     the hues, 1 to 6, as degrees or hex: 22,325,262
  -s, --steps N       colours in each family, 1 to 7
  -f, --format FMT    json (the default), hex (a family a line) or css
  -o, --out FILE      also write the palette as JSON on every change
  -x, --xterm         snap to the xterm-256 colour a TUI draws
      --print         print the palette for the options given, no picker
      --tab           pick in a new Ghostty tab, and this process waits
      --split         the same, in a split to the right
      --nested        the caller already holds the alternate screen

Enter prints the palette and exits 0. Esc or q prints nothing and exits 1.
A usage error exits 2. With no --hues it opens on your last pick.

Three things to set:

1 hues. Up to 6, though 2 or 3 usually read best. On a hue row, [ and ]
  step through a spectrum picked by eye to look evenly spaced, ← → nudge,
  e picks one in color-pick, a adds a hue and d drops one.
2 lightness. One bar with two handles, darkest and lightest. Each family
  steps evenly between them. The bar only spans the band where hues still
  carry colour, so no family goes to mud. + and - add or remove steps.
3 strength. How vivid, as a share of what each hue can carry at each
  lightness, so equal strength looks equally rich. It stops at 60%, so
  nothing goes grey.

Every hue at one lightness looks equally light (OKLCH), so step 2 of every
family reads as one row. Snapped to xterm-256, a colour keeps its hue and
never lands on a grey. The line under the palette names any two colours
that come too close.

Space shuffles the hues that are not held (x holds one). b steps back,
r resets, c copies the output, 8 toggles xterm-256 snapping.
"""

import base64
import json
import math
import os
import random
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty

HOME = os.path.expanduser("~")
STATE = os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state"))
LAST = os.path.join(STATE, "palette-pick", "last.json")

BOLD, DIM, REV, RED = "\x1b[1m", "\x1b[2m", "\x1b[7m", "\x1b[31m"
MAX_W, MIN_W = 76, 56


# --- rules ------------------------------------------------------------------
# The whole model. A family is one hue at one strength, stepped evenly in
# lightness from LO to HI. Lightness is OKLCH ×100, so equal lightness looks
# equally light across hues. Strength is a share of the most chroma the hue
# can carry at that lightness, so equal strength looks equally rich.

BAND = (38, 90)                 # outside this, hues carry too little colour
STRENGTH = (60, 100)            # below 60%, steps start to read as grey
MAX_HUES, MAX_STEPS = 6, 7
CLOSE, APART = 3.0, 6.0         # ΔE: steps closer than CLOSE look alike;
                                # families closer than APART blur together
DEFAULT = dict(hues=[22, 325, 262], lo=40, hi=74, strength=90, steps=5)

# A spectrum picked by eye: hues that read as evenly spaced at one lightness.
# OKLCH bunches the yellows and spreads the blues, so the degrees are uneven.
SPECTRUM = [("red", 22), ("coral", 40), ("orange", 58), ("amber", 78), ("yellow", 100),
            ("lime", 125), ("green", 145), ("teal", 180), ("cyan", 210), ("sky", 238),
            ("blue", 262), ("violet", 295), ("plum", 325), ("pink", 350)]


def lightness_steps(lo, hi, n):
    return [(lo + hi) / 2] if n == 1 else [lo + (hi - lo) * j / (n - 1) for j in range(n)]


def families(p):
    """Each hue's family, dark to light. Snapped as one palette, if asked."""
    fams = [[rel(L, p.strength, h) for L in lightness_steps(p.lo, p.hi, p.steps)] for h in p.hues]
    if p.snap:
        flat = snap_hue([c for f in fams for c in f])
        fams = [flat[i * p.steps:(i + 1) * p.steps] for i in range(len(fams))]
    return fams


def judge(fams):
    """The closest call: ("ok" | "steps" | "hues", ΔE, hex, hex, i, j)."""
    sib = min(((delta(a, b), a, b, i, i) for i, f in enumerate(fams) for a, b in zip(f, f[1:])),
              default=None)
    far = min(((delta(a, b), a, b, i, i + 1 + k) for i, f in enumerate(fams)
               for k, g in enumerate(fams[i + 1:]) for a in f for b in g), default=None)
    if sib and sib[0] < CLOSE:
        return ("steps",) + sib
    if far and far[0] < APART:
        return ("hues",) + far
    return ("ok",) + (far or sib or (99, None, None, 0, 0))


# --- colour -----------------------------------------------------------------

def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def hexof(r, g, b):
    return "#%02x%02x%02x" % (r, g, b)


def norm(v):
    """#rrggbb from #rgb, rrggbb, 0xrrggbb and the like, or None."""
    v = v.strip().strip("\"'").lower()
    v = v[2:] if v.startswith("0x") else v.lstrip("#")
    if re.fullmatch(r"[0-9a-f]{3}", v):
        v = "".join(ch * 2 for ch in v)
    return "#" + v if re.fullmatch(r"[0-9a-f]{6}", v) else None


def lin(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def unlin(c):
    c = max(0.0, min(1.0, c))
    return round(255 * (12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055))


def lab(h):
    r, g, b = (lin(v) for v in rgb(h))
    l, m, s = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b,
               0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b,
               0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def hue_of(h):
    _, a, b = lab(h)
    return round(math.degrees(math.atan2(b, a))) % 360


def linear_rgb(L, C, h):
    a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
    l, m, s = ((L + 0.3963377774 * a + 0.2158037573 * b) ** 3,
               (L - 0.1055613458 * a - 0.0638541728 * b) ** 3,
               (L - 0.0894841775 * a - 1.2914855480 * b) ** 3)
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def max_chroma(L, h):
    lo, hi = 0.0, 0.4
    for _ in range(18):
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if all(-1e-4 <= v <= 1 + 1e-4 for v in linear_rgb(L, mid, h)) else (lo, mid)
    return lo


def rel(L, strength, h):
    """The colour at lightness L (0-100) with strength% of the chroma h can carry there."""
    L = max(0, min(100, L)) / 100
    return hexof(*(unlin(v) for v in linear_rgb(L, max_chroma(L, h) * strength / 100, h)))


def delta(a, b):
    return 100 * math.dist(lab(a), lab(b))


STEPS = (0, 95, 135, 175, 215, 255)
CUBE = [hexof(r, g, b) for r in STEPS for g in STEPS for b in STEPS]
CUBE_LAB = {}


def snap_hue(colours):
    """Each colour to an xterm-256 colour, none used twice. Never a grey or
    a near-grey, and a miss in hue costs twice a miss in lightness."""
    if not CUBE_LAB:
        CUBE_LAB.update((c, lab(c)) for c in CUBE if math.hypot(*lab(c)[1:]) > 0.045)
    used, out = set(), []
    for h in colours:
        L, a, b = lab(h)
        pick = min((c for c in CUBE_LAB if c not in used),
                   key=lambda c: math.hypot(L - CUBE_LAB[c][0], 2 * (a - CUBE_LAB[c][1]),
                                            2 * (b - CUBE_LAB[c][2])))
        used.add(pick)
        out.append(pick)
    return out


def FG(h):
    return "\x1b[38;2;%d;%d;%dm" % rgb(h)


def BG(h):
    return "\x1b[48;2;%d;%d;%dm" % rgb(h)


def ink(h):
    r, g, b = rgb(h)
    return "#000000" if 0.299 * r + 0.587 * g + 0.114 * b > 140 else "#ffffff"


# --- the palette ------------------------------------------------------------

def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_atomic(path, text):
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".palette-pick.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


class Palette:
    def __init__(self, hues, lo, hi, strength, steps, snap):
        self.hues = [round(h) % 360 for h in hues]
        self.lo, self.hi, self.strength, self.steps, self.snap = lo, hi, strength, steps, snap
        self.locks = set()

    def state(self):
        return dict(hues=list(self.hues), lo=self.lo, hi=self.hi, strength=self.strength,
                    steps=self.steps, locks=sorted(self.locks))

    def restore(self, s):
        self.hues, self.lo, self.hi = list(s["hues"]), s["lo"], s["hi"]
        self.strength, self.steps, self.locks = s["strength"], s["steps"], set(s["locks"])

    def add(self, after):
        """A hue after row `after`: the spectrum hue furthest from the rest."""
        if len(self.hues) >= MAX_HUES:
            return False
        gap = lambda h: min(abs((h - x + 180) % 360 - 180) for x in self.hues)
        self.hues.insert(after + 1, max((h for _, h in SPECTRUM), key=gap))
        self.locks = {i + (i > after) for i in self.locks}
        return True

    def drop(self, i):
        if len(self.hues) <= 1:
            return False
        del self.hues[i]
        self.locks = {j - (j > i) for j in self.locks if j != i}
        return True

    def shuffle(self, rng):
        """New spectrum hues for the rows not held, spread out so families stay
        apart. Up to 60 tries; the best try wins if none is clean."""
        free = [i for i in range(len(self.hues)) if i not in self.locks]
        best = None
        for _ in range(60):
            pick = list(self.hues)
            pool = [h for _, h in SPECTRUM if h not in [pick[i] for i in self.locks]]
            for i in free:
                pick[i] = pool.pop(rng.randrange(len(pool)))
            trial = Palette(pick, self.lo, self.hi, self.strength, self.steps, self.snap)
            verdict = judge(families(trial))
            score = (verdict[0] == "ok", verdict[1])
            if not best or score > best[0]:
                best = (score, pick)
            if verdict[0] == "ok" and verdict[1] >= 2 * APART:
                break
        self.hues = best[1]

    def output(self):
        fams = families(self)
        return {"families": fams, "palette": [c for f in fams for c in f], "hues": list(self.hues),
                "lightness": [self.lo, self.hi], "strength": self.strength, "steps": self.steps,
                "xterm": self.snap, "verdict": judge(fams)[0]}

    def formatted(self, how):
        o = self.output()
        if how == "hex":
            return "\n".join(" ".join(f) for f in o["families"])
        if how == "css":
            return ":root {\n" + "\n".join("  --hue%d-%d: %s;" % (i + 1, j + 1, h) for i, f in
                                           enumerate(o["families"]) for j, h in enumerate(f)) + "\n}"
        return json.dumps(o, indent=2)


class Canvas:
    """A grid of (char, style) cells, flushed in one write so nothing tears."""

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.cells = [[(" ", "")] * w for _ in range(h)]

    def put(self, y, x, text, style="", limit=None):
        if not 0 <= y < self.h:
            return
        if limit is not None:
            text = text[:max(0, limit)]
        row = self.cells[y]
        for i, ch in enumerate(text):
            if 0 <= x + i < self.w:
                row[x + i] = (ch, style)

    def centred(self, w, h):
        big = Canvas(w, h)
        oy, ox = (h - self.h) // 2, (w - self.w) // 2
        for y, row in enumerate(self.cells):
            big.cells[oy + y][ox:ox + self.w] = row
        return big

    def render(self):
        out = ["\x1b[H"]
        for y, row in enumerate(self.cells):
            style = None
            for ch, st in row:
                if st != style:
                    out.append("\x1b[0m" + st)
                    style = st
                out.append(ch)
            out.append("\x1b[0m")
            if y < self.h - 1:
                out.append("\r\n")
        return "".join(out)


def box(c, y, x, w, h):
    c.put(y, x, "╭" + "─" * (w - 2) + "╮", DIM)
    for r in range(y + 1, y + h - 1):
        c.put(r, x, "│", DIM)
        c.put(r, x + w - 1, "│", DIM)
    c.put(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", DIM)


def cells(c, y, x, w, colours, mark=None, text=False):
    """colours side by side across w columns, the spare columns spread out."""
    n = len(colours)
    for j, v in enumerate(colours):
        a, b = x + j * w // n, x + (j + 1) * w // n
        label = v if text and b - a >= 9 else ("◆" if j == mark else "")
        c.put(y, a, label.center(b - a), BG(v) + FG(ink(v)))


# --- keys -------------------------------------------------------------------

SEQ = {"[A": "up", "[B": "down", "[C": "right", "[D": "left",
       "OA": "up", "OB": "down", "OC": "right", "OD": "left",
       "[1;2C": "S-right", "[1;2D": "S-left", "[1;2A": "up", "[1;2B": "down",
       "[Z": "S-tab"}
PLAIN = {"\r": "enter", "\n": "enter", "\t": "tab", "\x7f": "bs", "\x08": "bs",
         "\x03": "ctrl-c"}
CSI = re.compile(r"\x1b(\[[0-9;]*[A-Za-z~]|O[A-Za-z])")
PASTE_ON, PASTE_OFF = "\x1b[200~", "\x1b[201~"


def keys(data):
    s, i = data.decode("utf-8", "ignore"), 0
    while i < len(s):
        if s.startswith(PASTE_ON, i):
            end = s.find(PASTE_OFF, i)
            end = len(s) if end < 0 else end
            yield "paste:" + s[i + len(PASTE_ON):end]
            i = end + len(PASTE_OFF)
            continue
        m = CSI.match(s, i)
        if m:
            yield SEQ.get(m.group(1), "")
            i = m.end()
            continue
        yield "esc" if s[i] == "\x1b" else PLAIN.get(s[i], s[i])
        i += 1


def copy_text(text):
    """Into the clipboard: a native tool when there is one, else OSC 52."""
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=2)
                return ""
            except (OSError, subprocess.SubprocessError):
                pass
    return "\x1b]52;c;%s\a" % base64.b64encode(text.encode()).decode()


# --- app --------------------------------------------------------------------

class App:
    def __init__(self, pal, title, fmt, out_file, nested):
        self.tty = os.open("/dev/tty", os.O_RDWR)
        self.p, self.start = pal, pal.state()
        self.title, self.fmt, self.out_file, self.nested = title, fmt, out_file, nested
        self.rng = random.Random()
        self.row = 0
        self.back, self.prompt, self.msg, self.result, self.done = [], None, None, None, False

    def out(self, s):
        os.write(self.tty, s.encode())

    def say(self, text, style=""):
        self.msg = (text, style)

    def changed(self):
        if self.out_file:
            try:
                write_atomic(self.out_file, self.p.formatted("json") + "\n")
            except OSError as e:
                self.say(f"cannot write {self.out_file}: {e.strerror}", RED)

    def keep(self):
        self.back = (self.back + [self.p.state()])[-50:]

    def rows(self):
        return [("hue", i) for i in range(len(self.p.hues))] + [("lo",), ("hi",), ("strength",)]

    def here(self):
        rows = self.rows()
        self.row = max(0, min(self.row, len(rows) - 1))
        return rows[self.row]

    # --- keys ---------------------------------------------------------------

    def key(self, k):
        if k == "ctrl-c":
            self.done = True
            return
        if self.prompt is not None:
            return self.prompt_key(k)
        if k.startswith("paste:"):
            v = re.search(r"#?\b([0-9a-fA-F]{6})\b", k[6:])
            return self.take_hex(norm(v.group(1))) if v else self.say("no hex colour in that paste", RED)
        self.msg = None
        k = {"h": "left", "j": "down", "k": "up", "l": "right", "H": "S-left", "L": "S-right"}.get(k, k)
        p, here = self.p, self.here()
        i = here[1] if here[0] == "hue" else None
        if k == "enter":
            self.result, self.done = p.formatted(self.fmt), True
        elif k in ("esc", "q"):
            self.done = True
        elif k in ("up", "down", "tab", "S-tab"):
            self.row = (self.row + (1 if k in ("down", "tab") else -1)) % len(self.rows())
        elif len(k) == 1 and k in "123456":
            if int(k) <= len(p.hues):
                self.row = int(k) - 1
        elif k in ("left", "right", "S-left", "S-right"):
            self.nudge(here, (1 if k.endswith("right") else -1) * (5 if k.startswith("S-") else 1))
        elif k in ("[", "]") and i is not None:
            names = [h for _, h in SPECTRUM]
            ahead = [h for h in names if (h - p.hues[i]) % 360 not in (0,)]
            step = 1 if k == "]" else -1
            p.hues[i] = min(ahead, key=lambda h: (step * (h - p.hues[i])) % 360)
            self.changed()
        elif k in ("+", "=", "-", "_"):
            p.steps = max(1, min(MAX_STEPS, p.steps + (1 if k in "+=" else -1)))
            self.changed()
        elif k == "a":
            self.keep()
            at = i if i is not None else len(p.hues) - 1
            if p.add(at):
                self.row = at + 1
                self.say(f"hue {at + 2} added" + (" · 2 or 3 usually read best" if len(p.hues) > 3 else ""))
                self.changed()
            else:
                self.say(f"{MAX_HUES} hues at most")
        elif k == "d" and i is not None:
            self.keep()
            if p.drop(i):
                self.say(f"hue {i + 1} dropped · b brings it back")
                self.changed()
            else:
                self.say("one hue at least")
        elif k == "e" and i is not None:
            self.pick(i)
        elif k == "#" and i is not None:
            self.prompt = ""
        elif k == "x" and i is not None:
            p.locks ^= {i}
            self.say(f"hue {i + 1} " + ("held through shuffles" if i in p.locks else "free"))
        elif k == " ":
            self.keep()
            p.shuffle(self.rng)
            self.say("shuffled" + (" · held hues kept" if p.locks else ""))
            self.changed()
        elif k == "b":
            if self.back:
                p.restore(self.back.pop())
                self.changed()
            else:
                self.say("nothing to go back to")
        elif k == "r":
            self.keep()
            p.restore(self.start)
            self.say("back to the start")
            self.changed()
        elif k == "8":
            p.snap = not p.snap
            self.say("snapped to xterm-256" if p.snap else "full colour")
            self.changed()
        elif k == "c":
            self.out(copy_text(p.formatted(self.fmt)))
            self.say(f"copied the {self.fmt}")

    def nudge(self, here, step):
        p = self.p
        if here[0] == "hue":
            p.hues[here[1]] = (p.hues[here[1]] + 2 * step) % 360
        elif here[0] == "lo":
            p.lo = max(BAND[0], min(p.hi, p.lo + step))
        elif here[0] == "hi":
            p.hi = max(p.lo, min(BAND[1], p.hi + step))
        else:
            p.strength = max(STRENGTH[0], min(STRENGTH[1], p.strength + 5 * (1 if step > 0 else -1)))
        self.changed()

    def pick(self, i):
        """Hand hue i to color-pick, which takes this screen until it is done."""
        picker = shutil.which("color-pick") or os.path.join(HOME, "dotfiles", "bin", "color-pick")
        if not os.path.exists(picker):
            return self.say("color-pick is not installed · # types a hex instead", RED)
        mid = rel((self.p.lo + self.p.hi) / 2, self.p.strength, self.p.hues[i])
        r = subprocess.run([sys.executable, picker, "--nested", "-t", f"palette-pick: hue {i + 1}", mid],
                           stdout=subprocess.PIPE, text=True)
        v = norm(r.stdout.strip()) if r.returncode == 0 else None
        self.take_hex(v) if v else self.say(f"hue {i + 1} unchanged")

    def take_hex(self, v):
        here = self.here()
        if here[0] != "hue":
            return self.say("a hex goes on a hue row", RED)
        self.keep()
        self.p.hues[here[1]] = hue_of(v)
        self.say(f"hue {here[1] + 1} takes the hue of {v}")
        self.changed()

    def prompt_key(self, k):
        if k == "esc":
            self.prompt = None
        elif k == "enter":
            v = norm(self.prompt)
            if not v:
                return self.say(f"not a hex colour: {self.prompt}", RED)
            self.prompt = None
            self.take_hex(v)
        elif k == "bs":
            self.prompt = self.prompt[:-1]
        elif len(k) == 1 and k.isprintable() and len(self.prompt) < 8:
            self.prompt += k

    # --- layout -------------------------------------------------------------

    def height(self):
        return 2 + 3 + 2 + len(self.p.hues) + 1 + 2 + 2 + 2 + 1 + 2 + 1

    def draw(self):
        tw, th = os.get_terminal_size(self.tty)
        w, bh = min(tw, MAX_W), self.height()
        if w < MIN_W or th < bh + 4:
            c = Canvas(tw, th)
            c.put(th // 2, 1, f"need {MIN_W}×{bh + 4} · now {tw}×{th}", DIM)
            return self.out(c.render())
        p, fams = self.p, families(self.p)
        n, x, iw = len(p.hues), 2, w - 4
        tx = x + 9
        tr = iw - 9
        here = self.here() if self.prompt is None else None
        c = Canvas(w, bh + 4)

        c.put(0, 1, "palette-pick", BOLD)
        right = f"{n} hue{'s' * (n > 1)} · {p.steps} step{'s' * (p.steps > 1)}" + (" · xterm-256" if p.snap else "")
        if self.title:
            room = w - len(right) - 18
            c.put(0, 13, " · " + (self.title if len(self.title) <= room else self.title[:max(0, room - 1)] + "…"))
        c.put(0, w - 1 - len(right), right, BOLD)
        box(c, 1, 0, w, bh)

        # The palette, a gap between families, then one line on the closest call.
        span = tr - (n - 1)
        c.put(2, x, "palette", DIM)
        for i, f in enumerate(fams):
            a, b = tx + i * span // n + i, tx + (i + 1) * span // n + i
            cells(c, 2, a, b - a, f, text=True)
            cells(c, 3, a, b - a, f)
        kind, d, ca, cb, i, j = judge(fams)
        if kind == "steps":
            text, style, fix = f"hue {i + 1}'s steps look alike", RED, "widen the lightness range or use fewer steps"
        elif kind == "hues":
            text, style, fix = f"hue {i + 1} and hue {j + 1} come too close", RED, "turn one away"
        else:
            text, style, fix = "every colour tells apart", DIM, ""
        c.put(4, tx, text, style)
        cx = tx + len(text) + 1
        if ca and kind != "ok":
            for v in (ca, cb):
                c.put(4, cx, "  ", BG(v))
                cx += 3
            c.put(4, cx, fix, style, limit=tx + tr - cx)

        # 1: the hues, then the spectrum they come from.
        y = 6
        c.put(y, x, "1 hues", BOLD)
        c.put(y, x + 8, "[ ] spectrum · ← → nudge · a add · d drop · e color-pick", DIM)
        for i, f in enumerate(fams):
            y += 1
            on = here == ("hue", i)
            c.put(y, x, ("› " if on else "  ") + f"{i + 1}" + (" x" if i in p.locks else ""), BOLD if on else DIM)
            name = min(SPECTRUM, key=lambda s: abs((s[1] - p.hues[i] + 180) % 360 - 180))
            label = name[0] if abs((name[1] - p.hues[i] + 180) % 360 - 180) < 3 else f"{p.hues[i]}°"
            c.put(y, tx, label, BOLD if on else DIM)
            cells(c, y, tx + 8, tr - 8, f, text=True)
        y += 1
        mid = (p.lo + p.hi) / 2
        chips = [rel(mid, p.strength, h) for _, h in SPECTRUM]
        cw = (tr - 8) // len(chips)
        for k, v in enumerate(chips):
            used = SPECTRUM[k][1] in p.hues
            c.put(y, tx + 8 + k * cw, ("◆" if used else "").center(cw), BG(v) + FG(ink(v)))

        # 2: one lightness bar, two handles, a tick per step.
        y += 2
        c.put(y, x, "2 lightness", BOLD)
        c.put(y, x + 13, "darkest to lightest · + - steps", DIM)
        y += 1
        on_lo, on_hi = here == ("lo",), here == ("hi",)
        c.put(y, x, ("› dark" if on_lo else "› light" if on_hi else "  range"), BOLD if (on_lo or on_hi) else DIM)
        col = lambda L: round((L - BAND[0]) * (tr - 1) / (BAND[1] - BAND[0]))
        lo, hi = col(p.lo), col(p.hi)
        ticks = {col(L) for L in lightness_steps(p.lo, p.hi, p.steps)}
        shade = rel(mid, p.strength, p.hues[0])
        for k in range(tr):
            L = BAND[0] + (BAND[1] - BAND[0]) * k / (tr - 1)
            if k in (lo, hi):
                active = (k == lo and on_lo) or (k == hi and on_hi)
                ch, st = "●", BOLD + (REV if active else "")
            elif k in ticks:
                ch, st = "┼", BOLD + FG("#ffffff")
            elif lo < k < hi:
                ch, st = "─", BOLD + FG("#ffffff")
            else:
                ch, st = "─", DIM
            c.put(y, tx + k, ch, st)
        y += 1
        c.put(y, tx, f"{p.lo}", BOLD if on_lo else DIM)
        c.put(y, tx + tr - len(str(p.hi)), f"{p.hi}", BOLD if on_hi else DIM)

        # 3: strength.
        y += 2
        on = here == ("strength",)
        word = "calm" if p.strength < 75 else "rich" if p.strength < 90 else "vivid"
        c.put(y, x, "3 strength", BOLD)
        c.put(y, x + 13, f"{p.strength}% · {word}", BOLD if on else DIM)
        y += 1
        c.put(y, x, "› " if on else "  ", BOLD)
        pos = round((p.strength - STRENGTH[0]) * (tr - 1) / (STRENGTH[1] - STRENGTH[0]))
        for k in range(tr):
            c.put(y, tx + k, "●" if k == pos else "─", (BOLD + (REV if on else "")) if k == pos else
                  BOLD + FG("#ffffff") if k < pos else DIM)

        # What the row under the cursor does.
        y += 2
        help_ = {"hue": "[ ] step through the spectrum · ← → nudge · x hold · # hex",
                 "lo": "← → move the dark end · ⇧ by 5", "hi": "← → move the light end · ⇧ by 5",
                 "strength": "← → by 5% · 60% is the floor, so nothing goes grey"}
        if here:
            c.put(y, x, help_[here[0]], DIM, limit=iw)
        self.draw_footer(c, w, bh + 1)
        self.out(c.centred(tw, th).render())

    def draw_footer(self, c, w, y):
        if self.prompt is not None:
            c.put(y, 1, "hex # ", BOLD)
            c.put(y, 7, self.prompt)
            c.put(y, 7 + len(self.prompt), " ", REV)
            c.put(y + 1, 1, "enter ok · esc cancel", DIM)
            return
        if self.msg:
            c.put(y, 1, self.msg[0], self.msg[1], limit=w - 2)
            y += 1
        hints = ["enter done", "esc cancel", "↑↓ rows", "1-6 a hue", "space shuffle", "b back",
                 "+- steps", "8 xterm", "c copy", "r reset"]
        line = ""
        for hint in hints:
            if len(line) + len(hint) + 3 > w - 2:
                c.put(y, 1, line, DIM)
                y, line = y + 1, ""
            line += (" · " if line else "") + hint
        c.put(y, 1, line, DIM)

    def run(self):
        old = termios.tcgetattr(self.tty)
        self.out(("\x1b[2J" if self.nested else "\x1b[?1049h") + "\x1b[?25l\x1b[?7l\x1b[?2004h")
        tty.setraw(self.tty)
        self.changed()
        try:
            size, stale = None, True
            while not self.done:
                now = os.get_terminal_size(self.tty)
                if stale or now != size:
                    self.draw()
                    size, stale = now, False
                if select.select([self.tty], [], [], 0.25)[0]:
                    for k in keys(os.read(self.tty, 4096)):
                        self.key(k)
                        if self.done:
                            break
                    stale = True
        finally:
            termios.tcsetattr(self.tty, termios.TCSADRAIN, old)
            self.out("\x1b[?2004l\x1b[?7h\x1b[?25h" + ("\x1b[0m\x1b[2J\x1b[H" if self.nested else "\x1b[?1049l"))
            os.close(self.tty)
        if self.result:
            try:
                write_atomic(LAST, json.dumps(self.p.state()) + "\n")
            except OSError:
                pass
        elif self.out_file:
            self.p.restore(self.start)        # a cancel puts the live preview back
            self.changed()
        return self.result


APPLESCRIPT = """
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to item 2 of argv
    set wait after command of cfg to false
    if item 1 of argv is "split" then
      split (focused terminal of selected tab of front window) direction right with configuration cfg
    else
      new tab in front window with configuration cfg
    end if
  end tell
end run
"""


def elsewhere(where, args):
    """Run the picker in a Ghostty tab or split and wait for its answer."""
    if sys.platform != "darwin" or not shutil.which("osascript"):
        die("palette-pick: --tab and --split need Ghostty on macOS")
    d = tempfile.mkdtemp(prefix="palette-pick.")
    answer = os.path.join(d, "answer")
    me = os.path.realpath(__file__)
    cmd = " ".join(shlex.quote(a) for a in [sys.executable, me, "--answer", answer] + args)
    r = subprocess.run(["osascript", "-e", APPLESCRIPT, where, cmd], capture_output=True, text=True)
    if r.returncode:
        shutil.rmtree(d, ignore_errors=True)
        die("palette-pick: could not open a Ghostty %s: %s" % (where, r.stderr.strip()))
    try:
        t0 = time.time()
        while not os.path.exists(answer):
            if not os.path.exists(answer + ".started") and time.time() - t0 > 10:
                die("palette-pick: the picker %s never started" % where)
            time.sleep(0.1)
        with open(answer) as f:
            return f.read().rstrip("\n") or None
    except KeyboardInterrupt:
        return None
    finally:
        shutil.rmtree(d, ignore_errors=True)


# --- main ---------------------------------------------------------------------

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def parse(argv):
    opts = {"title": None, "hues": None, "steps": None, "format": "json", "out": None, "xterm": False,
            "print": False, "where": None, "nested": False, "answer": None}
    takes = {"-t": "title", "--title": "title", "--hues": "hues", "-s": "steps", "--steps": "steps",
             "-f": "format", "--format": "format", "-o": "out", "--out": "out", "--answer": "answer"}
    flags = {"-x": "xterm", "--xterm": "xterm", "--print": "print", "--nested": "nested"}
    rest, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if "=" in a and a.split("=", 1)[0] in takes:
            a, val = a.split("=", 1)
            argv = argv[:i] + [a, val] + argv[i + 1:]
        if a in takes:
            if i + 1 >= len(argv):
                die(f"palette-pick: {a} needs a value")
            opts[takes[a]] = argv[i + 1]
            if takes[a] != "answer":
                rest += [a, argv[i + 1]]
            i += 2
            continue
        if a in ("--tab", "--split"):
            opts["where"] = a[2:]
        elif a in flags:
            opts[flags[a]] = True
            rest.append(a)
        else:
            die(f"palette-pick: unknown option {a} · try --help")
        i += 1
    if opts["format"] not in ("json", "hex", "css"):
        die("palette-pick: --format is json, hex or css")
    return opts, rest


def build(opts):
    """The palette to open on: the options given, over your last pick."""
    s = dict(DEFAULT)
    last = load_json(LAST)
    if isinstance(last.get("hues"), list) and "lo" in last:
        s.update({k: last[k] for k in DEFAULT if k in last})
    if opts["hues"]:
        hues = []
        for v in re.split(r"[\s,]+", opts["hues"].strip()):
            if re.fullmatch(r"-?\d+(\.\d+)?", v):
                hues.append(round(float(v)))
            elif norm(v):
                hues.append(hue_of(norm(v)))
            else:
                die(f"palette-pick: not a hue or hex colour: {v}")
        if not 1 <= len(hues) <= MAX_HUES:
            die(f"palette-pick: --hues takes 1 to {MAX_HUES}")
        s["hues"] = hues
    if opts["steps"]:
        if not opts["steps"].isdigit() or not 1 <= int(opts["steps"]) <= MAX_STEPS:
            die(f"palette-pick: --steps is 1 to {MAX_STEPS}")
        s["steps"] = int(opts["steps"])
    lo = max(BAND[0], min(BAND[1], int(s["lo"])))
    hi = max(lo, min(BAND[1], int(s["hi"])))
    strength = max(STRENGTH[0], min(STRENGTH[1], int(s["strength"])))
    p = Palette(s["hues"][:MAX_HUES], lo, hi, strength, max(1, min(MAX_STEPS, int(s["steps"]))), opts["xterm"])
    p.locks = {i for i in last.get("locks", []) if isinstance(i, int) and i < len(p.hues)}
    return p


def main():
    opts, rest = parse(sys.argv[1:])
    if opts["where"]:
        result = elsewhere(opts["where"], [a for a in rest if a != "--nested"])
    else:
        p = build(opts)
        if opts["print"]:
            print(p.formatted(opts["format"]))
            if opts["out"]:
                write_atomic(opts["out"], p.formatted("json") + "\n")
            return
        try:
            open("/dev/tty").close()
        except OSError:
            die("palette-pick: needs a terminal · or use --print")
        signal.signal(signal.SIGHUP, lambda *_: sys.exit(1))
        result = None
        if opts["answer"]:
            write_atomic(opts["answer"] + ".started", "")
        try:
            result = App(p, opts["title"], opts["format"], opts["out"], opts["nested"]).run()
        finally:
            if opts["answer"]:
                write_atomic(opts["answer"], (result or "") + "\n")
    if not result:
        sys.exit(1)
    print(result)


if __name__ == "__main__":
    main()
